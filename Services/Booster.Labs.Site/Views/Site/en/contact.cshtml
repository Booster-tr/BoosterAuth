@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">@m.T("nav.contact")</span>
                <h1 class="reveal reveal-d1">Get in touch</h1>
                <p class="lead reveal reveal-d2">
                    We would be glad to hear from you about our products, our games, or partnership
                    opportunities. The fastest way to reach us is by email.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="mailto:info@@boosterslabs.com">Send an email</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/products">@m.T("nav.products")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs emblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="eyebrow">Contact</span>
                <h2 class="mt-2">Write to us by email</h2>
                <p class="lead mt-2">
                    Email is our primary channel for every question. Send your message and we will get
                    back to you as soon as we can.
                </p>
                <ul class="info-list mt-3">
                    <li>
                        <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
                        <span>info@@boosterslabs.com</span>
                    </li>
                    <li>
                        <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
                        <span>Turkey</span>
                    </li>
                </ul>
                <div class="actions mt-4">
                    <a class="btn btn-primary btn-lg" href="mailto:info@@boosterslabs.com">Send an email</a>
                </div>
            </div>
            <div class="split-media reveal reveal-d1">
                <img class="hero-mark" src="~/img/mark-light-512.png" alt="Boosters Labs emblem" width="280" height="280" />
            </div>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">How can we help</span>
            <h2 class="reveal reveal-d1">Reach the right topic</h2>
            <p class="lead center reveal reveal-d2">
                The links below open an email to the same address with a ready subject line, so we can
                route your request faster.
            </p>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16v10H4z"/><path d="M8 7V5h8v2"/></svg></span>
                <h3>Sales &amp; partnerships</h3>
                <p>Let's talk about licensing, pricing and partnership opportunities.</p>
                <div class="actions">
                    <a class="btn btn-ghost" href="mailto:info@@boosterslabs.com?subject=Sales%20and%20partnerships">Write to us</a>
                </div>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Support</h3>
                <p>Reach out for technical questions about your installation.</p>
                <div class="actions">
                    <a class="btn btn-ghost" href="mailto:info@@boosterslabs.com?subject=Support">Write to us</a>
                </div>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg></span>
                <h3>General</h3>
                <p>For any other questions and your feedback.</p>
                <div class="actions">
                    <a class="btn btn-ghost" href="mailto:info@@boosterslabs.com">Write to us</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Ready to talk?</h2>
            <p class="lead">Send your message and we will get back to you as soon as we can.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="mailto:info@@boosterslabs.com">Send an email</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/about">@m.T("nav.about")</a>
            </div>
        </div>
    </div>
</section>
