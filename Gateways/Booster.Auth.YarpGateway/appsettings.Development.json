{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MassTransit": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "idp_route": {
        "ClusterId": "idp_cluster",
        "Order": -1,
        "Match": {
          "Path": "/authn/ui/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/authn" }
        ]
      },
      "systemmessage_route": {
        "ClusterId": "systemmessage_cluster",
        "Match": {
          "Path": "/systemmessage/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/systemmessage" }
        ]
      }

    },
    "Clusters": {
      "idp_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5090"
          }
        }
      },
      "systemmessage_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7153"
          }
        }
      }
    }
  }
}