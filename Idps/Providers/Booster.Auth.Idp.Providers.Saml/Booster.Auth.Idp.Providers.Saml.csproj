    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <!-- ITfoxtec'in dolayli getirdigi 10.0.12'de XML imza dogrulama aciklari var (GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83). -->
