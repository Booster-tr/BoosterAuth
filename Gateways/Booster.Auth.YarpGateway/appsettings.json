{
  "Version": "0.1.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "idp_route": {
        "ClusterId": "idp_cluster",
        "Order": -1,
        "Match": {
          "Path": "/idp/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/idp" },
          { "RequestHeaderOriginalHost": "false" },
          { "X-Forwarded": "Set" }
        ]
      },
      "management_route": {
        "ClusterId": "management_cluster",
        "Order": -1,
        "Match": {
          "Path": "/management/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/management" },
          { "RequestHeaderOriginalHost": "false" },
          { "X-Forwarded": "Set" }
        ]
      },
      "authz_route": {
        "ClusterId": "authz_cluster",
        "Order": -1,
        "Match": {
          "Path": "/authz/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderOriginalHost": "false" },
          { "X-Forwarded": "Set" }
        ]
      },
      "systemmessage_route": {
        "ClusterId": "systemmessage_cluster",
        "Match": {
          "Path": "/systemmessage/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/systemmessage" }
        ]
      }
    },
    "Clusters": {
      "idp_cluster": {
        "Destinations": {
          "destination1": { "Address": "http://booster-idp:8080" }
        }
      },
      "management_cluster": {
        "Destinations": {
          "destination1": { "Address": "http://booster-management-api:8080" }
        }
      },
      "authz_cluster": {
        "Destinations": {
          "destination1": { "Address": "http://booster-authz:8080" }
        }
      },
      "systemmessage_cluster": {
        "Destinations": {
          "destination1": { "Address": "http://booster-systemmessage:8080" }
        }
      }
    }
  }
}
