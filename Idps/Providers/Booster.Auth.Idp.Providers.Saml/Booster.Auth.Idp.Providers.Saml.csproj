<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Booster.Auth.Idp.Providers.Abstractions\Booster.Auth.Idp.Providers.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SAML imza dogrulamasi elle YAZILMAZ: imza sarmalama (XSW) ve XXE
