@model Booster.Auth.Database.Models.PasswordPolicyData?
@if (Model is not null)
{
    var rules = new List<string> { T["Password.Rules.MinLength", Model.MinLength].Value };

    if (Model.RequireUppercase) rules.Add(T["Password.Rules.Uppercase"].Value);
    if (Model.RequireLowercase) rules.Add(T["Password.Rules.Lowercase"].Value);
    if (Model.RequireDigit) rules.Add(T["Password.Rules.Digit"].Value);
    if (Model.RequireNonAlphanumeric) rules.Add(T["Password.Rules.NonAlphanumeric"].Value);

    rules.Add(T["Password.Rules.NoWhitespace"].Value);

    <div class="auth-field__hint" id="Password-hint">
        <p>@T["Password.Rules.Intro"]</p>
        <ul class="auth-rules">
            @foreach (var rule in rules)
            {
                <li>@rule</li>
            }
        </ul>
    </div>
}
