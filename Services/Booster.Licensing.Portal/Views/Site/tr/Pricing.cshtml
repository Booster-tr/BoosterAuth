@using Booster.Licensing.Portal.Services
@{
    var c = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var featured = Model.Plans.Count > 1 ? Model.Plans[1].Code : null;
}
<section class="page-hero">
    <div class="wrap">
        <span class="eyebrow" style="color:var(--teal)">Paketler</span>
        <h1 class="reveal">Sade fiyatlandırma, tüm özellikler dahil</h1>
        <p class="reveal" style="--d:.08s">Paketler yalnızca kullanıcı, havuz ve uygulama limitlerinde ayrılır. Lisans kurulum başınadır ve yıllıktır;
            kullanıcı başına aylık ücret yoktur.</p>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="plans">
            <article class="plan reveal" data-plan="deneme">
                <h3>Ücretsiz deneme</h3>
                <div class="price">0 ₺</div>
                <p class="muted small">Ürünü kendi ortamınızda deneyin.</p>
                <ul>
                    <li>@LicenseIssuer.Defaults.TrialUsers.ToString("N0", c) kullanıcı</li>
                    <li>@LicenseIssuer.Defaults.TrialPools kullanıcı havuzu</li>
                    <li>@LicenseIssuer.Defaults.TrialClients uygulama</li>
                    <li>@LicenseIssuer.Defaults.TrialDays gün</li>
                </ul>
                <a class="btn btn-ghost" href="/hesap/satin-al?plan=deneme">Ücretsiz dene</a>
            </article>
            @foreach (var (p, i) in Model.Plans.Select((p, i) => (p, i)))
            {
                <article class="plan reveal @(p.Code == featured ? "featured" : "")" style="--d:@((i + 1) * 0.06)s" data-plan="@p.Code">
                    @if (p.Code == featured) { <span class="badge">En çok tercih edilen</span> }
                    <h3>@p.Name</h3>
                    <div class="price">@(p.Price > 0 ? $"{p.Price.ToString("N0", c)} {p.Currency}" : "Teklif alın")@if (p.Price > 0) {<small> / @p.DurationMonths ay</small>}</div>
                    <p class="muted small">Havale / EFT ile ödeme; lisans e-postanıza gelir.</p>
                    <ul>
                        <li>@p.MaxUsers.ToString("N0", c) kullanıcı</li>
                        <li>@p.MaxPools kullanıcı havuzu</li>
                        <li>@p.MaxClients uygulama</li>
                        <li>Tüm özellikler</li>
                    </ul>
                    <a class="btn @(p.Code == featured ? "btn-primary" : "btn-ghost")" href="/hesap/satin-al?plan=@Uri.EscapeDataString(p.Code)" data-buy="@p.Code">Lisans al</a>
                </article>
            }
        </div>
        <p class="center muted small" style="margin-top:1.5rem">Yönetim paneli kullanıcıları ve yönetim havuzu limitlere dahil değildir.</p>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="section-head reveal"><h2>Sık sorulan sorular</h2></div>
        <div class="faq">
            <details class="reveal"><summary>Deneme lisansını kimler alabilir?</summary>
                <p>Firma e-posta adresiyle kayıt olan herkes. Kurulumun domain'i e-posta domain'inizle uyuşmalı ve her domain için bir kez deneme verilir. Ücretsiz e-posta adresleriyle (gmail, outlook vb.) deneme alınamaz.</p></details>
            <details class="reveal"><summary>Ödeme nasıl yapılır?</summary>
                <p>Lisans portalında siparişinizi oluşturduğunuzda size bir referans kodu ve havale / EFT bilgileri verilir. Ödeme onaylanınca lisansınız otomatik üretilir ve e-postanıza gönderilir.</p></details>
            <details class="reveal"><summary>Lisans süresi dolarsa ne olur?</summary>
                <p>Bitişten sonra ek süre boyunca her şey çalışır: ücretli lisansta @LicenseIssuer.Defaults.PaidGraceDays gün, denemede @LicenseIssuer.Defaults.TrialGraceDays gün. Ardından yönetim paneli salt okunur olur; ücretli lisanslarda son kullanıcı girişleri kesilmez. Deneme lisansında ek süre bitince son kullanıcı girişleri de durur.</p></details>
            <details class="reveal"><summary>Erken yenilersem kalan günlerim yanar mı?</summary>
                <p>Hayır. Yeni süre mevcut lisansınızın bitiş tarihine eklenir.</p></details>
            <details class="reveal"><summary>Sunucumu değiştirirsem ne olur?</summary>
                <p>Lisansınızı portaldan yeni kurulumunuza kendiniz aktarabilirsiniz; yılda en fazla 3 aktarım hakkı vardır.</p></details>
            <details class="reveal"><summary>Ürün internete bağlanmak zorunda mı?</summary>
                <p>Hayır. Lisans ürün içinde çevrimdışı doğrulanır. İnternet yalnızca kurulumda image'ları indirmek için gerekir.</p></details>
        </div>
    </div>
</section>
