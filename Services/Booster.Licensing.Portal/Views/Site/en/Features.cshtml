            <a class="btn btn-primary btn-lg" href="/en/download">Download free <span class="arrow">→</span></a>
            <a class="btn btn-ghost btn-lg" href="/en/docs/concepts" style="margin-left:.5rem">Learn the concepts</a>
        </div>
    </div>
</section>
