@model List<Order>
@{
    ViewData["Title"] = "Siparişler";
    var status = ViewBag.Status as OrderStatus?;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}
<div class="page-head">
    <h1>Siparişler</h1>
    <nav class="nav">
        <a href="/admin/siparisler?status=Pending">Ödeme bekleyen</a>
        <a href="/admin/siparisler?status=Paid">Onaylanan</a>
        <a href="/admin/siparisler?status=Cancelled">İptal</a>
        <a href="/admin/siparisler">Tümü</a>
    </nav>
    <form method="post" action="/admin/hatirlatmalar/calistir" asp-antiforgery="true">
        <button class="btn btn-ghost btn-sm" type="submit" title="Normalde 6 saatte bir otomatik çalışır">Yenileme hatırlatmalarını şimdi gönder</button>
    </form>
</div>
@if (TempData["Info"] is string info) { <p class="alert" data-flash="info">@info</p> }
@if (TempData["Error"] is string err) { <p class="alert" data-flash="error">@err</p> }
@if (Model.Count == 0)
{
    <p class="muted">@(status is null ? "Sipariş yok." : "Bu durumda sipariş yok.")</p>
}
else
{
    <table>
        <thead><tr><th>Referans</th><th>Müşteri</th><th>Plan</th><th>Tutar</th><th>Tarih</th><th>Durum</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr data-order="@o.ReferenceCode">
                <td><code>@o.ReferenceCode</code></td>
                <td><a href="/admin/musteriler/detay?CustomerId=@o.CustomerId">@o.Customer.Name</a></td>
                <td>@o.PlanName</td>
                <td>@(o.Price > 0 ? $"{o.Price.ToString("N2", tr)} {o.Currency}" : "—")</td>
                <td>@o.CreatedTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@o.Status@(o.PaidBy is not null ? $" ({o.PaidBy})" : "")</td>
                <td>
                    @if (o.Status == OrderStatus.Pending)
                    {
                        <form method="post" action="/admin/siparisler/odeme" asp-antiforgery="true" style="display:inline">
                            <input type="hidden" name="orderId" value="@o.Id" />
                            <button class="btn btn-primary btn-sm" type="submit">Ödeme alındı</button>
                        </form>
                        <form method="post" action="/admin/siparisler/iptal" asp-antiforgery="true" style="display:inline">
                            <input type="hidden" name="orderId" value="@o.Id" />
                            <button class="btn btn-ghost btn-sm" type="submit">İptal</button>
                        </form>
                    }
                    else if (o.LicenseId is not null)
                    {
                        <a class="btn btn-ghost btn-sm" href="/admin/lisanslar/detay?LicenseId=@o.LicenseId">Lisans</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
