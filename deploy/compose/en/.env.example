# =============================================================================
#  Booster Auth settings
#
#  Instead of filling this file by hand, run the setup script:
#    Linux / macOS:  ./setup.sh
#    Windows:        powershell -ExecutionPolicy Bypass -File .\setup.ps1
#  The script asks for the addresses, generates random passwords and keys, and writes the .env file.
#
#  BACK UP the .env file and do NOT SHARE it. If HASHING_* or IDP_APPLICATION_PEPPER are changed after setup,
#  existing passwords and encrypted data can no longer be read.
# =============================================================================

COMPOSE_PROJECT_NAME=booster-auth

# Booster Auth version to run (image tag). "latest" = newest version.
BOOSTER_VERSION=latest

# ------------------------------------------------------------------ addresses
# Public address of Booster Auth (IdP, APIs). Must be one of the domains in the license.
PUBLIC_HOST=auth.company.com
GATEWAY_HTTPS_PORT=443
# If you use a port other than 443, append it: https://auth.company.com:8443
PUBLIC_URL=https://auth.company.com

# Management panel
PANEL_PORT=3000
PANEL_PUBLIC_URL=http://localhost:3000
# Set to "true" if the panel is behind https (reverse proxy); empty = automatic.
SESSION_COOKIE_SECURE=

# IP the ports listen on. 127.0.0.1 for access from this machine only.
PUBLIC_BIND_IP=0.0.0.0

# ------------------------------------------------------------------ administrator
# First administrator account. Empty e-mail means admin@booster.local. Use a REAL mailbox if you will enable 2FA.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------ secrets (generated by the setup script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
OPENFGA_PRESHARED_KEY=CHANGE_ME
HASHING_PEPPER=CHANGE_ME
# base64, 32 bytes
HASHING_ENCRYPTION_KEY=CHANGE_ME
IDP_APPLICATION_PEPPER=CHANGE_ME
PANEL_SESSION_SECRET=CHANGE_ME

# ------------------------------------------------------------------ e-mail (optional)
# For sign-up verification, invitation and password reset e-mails. Leave empty to send no e-mail.
MAIL_SENDER=
MAIL_DISPLAY_NAME=Booster Auth
MAIL_SMTP_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLE_SSL=true

# ------------------------------------------------------------------ other
LOG_LEVEL=Information
# Licensing portal (the panel's "Get a license" button goes here)
LICENSING_PORTAL_URL=https://licensing.appnuraymind.com
