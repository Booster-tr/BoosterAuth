# =============================================================================
#  Booster Auth ayarlari
#
#  Bu dosyayi elle doldurmak yerine kurulum betigini calistirin:
#    Linux / macOS:  ./kurulum.sh
#    Windows:        powershell -ExecutionPolicy Bypass -File .\kurulum.ps1
#  Betik adresleri sorar, parola ve anahtarlari rastgele uretir ve .env dosyasini yazar.
#
#  .env dosyasini YEDEKLEYIN ve kimseyle PAYLASMAYIN. HASHING_* ve IDP_APPLICATION_PEPPER kurulumdan sonra
#  degistirilirse mevcut parolalar ve sifreli veriler okunamaz.
# =============================================================================

COMPOSE_PROJECT_NAME=booster-auth

# Kullanilacak Booster Auth surumu (image etiketi). "latest" = en guncel surum.
BOOSTER_VERSION=latest

# ------------------------------------------------------------------ adresler
# Booster Auth'un disaridan erisilen adresi (IdP, API'ler). Lisanstaki domain'lerden biri olmali.
PUBLIC_HOST=auth.firma.com
GATEWAY_HTTPS_PORT=443
# 443 disinda bir port kullaniyorsaniz sonuna ekleyin: https://auth.firma.com:8443
PUBLIC_URL=https://auth.firma.com

# Yonetim paneli
PANEL_PORT=3000
PANEL_PUBLIC_URL=http://localhost:3000
# Panel https arkasindaysa (reverse proxy) "true" yapin; bos = otomatik.
SESSION_COOKIE_SECURE=

# Portlarin dinledigi IP. Yalnizca bu makineden erisim icin 127.0.0.1.
PUBLIC_BIND_IP=0.0.0.0

# ------------------------------------------------------------------ yonetici
# Ilk yonetici hesabi. E-posta bos ise admin@booster.local. 2FA acacaksaniz GERCEK bir posta kutusu girin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------ gizli degerler (kurulum betigi uretir)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
OPENFGA_PRESHARED_KEY=CHANGE_ME
HASHING_PEPPER=CHANGE_ME
# base64, 32 bayt
HASHING_ENCRYPTION_KEY=CHANGE_ME
IDP_APPLICATION_PEPPER=CHANGE_ME
PANEL_SESSION_SECRET=CHANGE_ME

# ------------------------------------------------------------------ e-posta (istege bagli)
# Kayit dogrulama, davet ve sifre sifirlama e-postalari icin. Bos birakilirsa e-posta gonderilmez.
MAIL_SENDER=
MAIL_DISPLAY_NAME=Booster Auth
MAIL_SMTP_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLE_SSL=true

# ------------------------------------------------------------------ diger
LOG_LEVEL=Information
# Lisans portali (panelde "Lisans al" butonu buraya gider)
LICENSING_PORTAL_URL=https://licensing.appnuraymind.com
