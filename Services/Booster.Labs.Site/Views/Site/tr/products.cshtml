@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">Urunlerimiz</span>
                <h1 class="reveal reveal-d1">Kurumsal yazilim, ayni muhendislik titizligiyle.</h1>
                <p class="lead reveal reveal-d2">
                    Boosters Labs; kurumlarin kimlik ve yetkilendirme ihtiyacini uctan uca karsilayan
                    urunler gelistirir. Her urun guvenlik, sadelik ve <strong>verilerin sizde kalmasi</strong>
                    ilkesiyle insa edilir.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/products/boosters-auth">Boosters Auth</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs amblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="pill pill-gold">Urun</span>
                <h2 class="mt-2">Boosters Auth</h2>
                <p class="lead">
                    Cok kiracili (multi-tenant) OIDC/OAuth2 kimlik saglayici ve OpenFGA tabanli
                    iliskisel yetkilendirme platformu. Tek urunde kimlik dogrulama ve yetki yonetimi.
                </p>
                <ul class="ticks">
                    <li>On-prem calisir; cevrimdisi lisanslanir, verileriniz sizde kalir.</li>
                    <li>SSO, parolasiz giris ve MFA ile modern kimlik akislari.</li>
                    <li>Google, Microsoft, Apple ve daha fazlasiyla federasyon; LDAP / Active Directory.</li>
                    <li>OpenFGA ile ince taneli, iliskisel yetkilendirme.</li>
                </ul>
                <div class="actions">
                    <a class="btn btn-primary" href="/@lang/products/boosters-auth">@m.T("cta.details")</a>
                    <a class="btn btn-ghost" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="split-media reveal reveal-d1">
                <img src="~/img/mark-light-512.png" alt="Boosters Auth" width="420" height="420" />
            </div>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Ortak ilkeler</span>
            <h2 class="reveal reveal-d1">Her urunun pesinde kostugu sey</h2>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Guvenlik varsayilan</h3>
                <p>Guvenlik tasarimda vardir; sonradan eklenen bir ozellik degildir.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></span>
                <h3>Size ait kalir</h3>
                <p>On-prem ve cevrimdisi secenekleriyle veri ve altyapi kontrolu tamamen sizde.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
                <h3>Standartlara uyum</h3>
                <p>OIDC/OAuth2 gibi acik standartlara uyar; ongorulebilir ve anlasilir davranir.</p>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Yol haritasi</span>
            <h2 class="reveal reveal-d1">Daha fazlasi yolda</h2>
            <p class="lead center reveal reveal-d2">
                Boosters Auth urun ailemizin ilk uyesi. Ayni ilkelerle gelistirdigimiz
                yeni cozumleri zamani geldikce burada paylasacagiz. Ozel bir ihtiyaciniz
                varsa bize yazin; dinlemeyi severiz.
            </p>
            <div class="actions center reveal reveal-d3">
                <a class="btn btn-ghost" href="/@lang/contact">@m.T("cta.contact")</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Urununuzu konusalim</h2>
            <p class="lead">Kurumunuzun kimlik ve yetki ihtiyacini birlikte degerlendirelim.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/products/boosters-auth">Boosters Auth</a>
            </div>
        </div>
    </div>
</section>
