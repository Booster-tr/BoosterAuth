<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Booster.Authorization.Fga</PackageId>
    <Version>1.0.0</Version>
    <Authors>Booster</Authors>
    <Description>
      Tüketici servislerin uçlarını attribute ile koruyup yetki kararını
      Booster.Auth.Z (OpenFGA tabanlı AuthZ servisi) üzerinden veren
      policy-based authorization paketi.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
  </ItemGroup>

  <!--
    IRequestContextAccessor için. Bu, Common -> CommonInternal yönünde bir
    bağımlılıktır ve paketi Booster.Auth.Manager'a (dolayısıyla JwtBearer'a)
    bağlar. Ayrıştırmak isterseniz: pakette küçük bir izolasyon sözleşmesi
    tanımlanıp tüketici tarafında RequestContext'e bağlanan bir adaptör yazılır.
  -->
  <ItemGroup>
    <!-- gRPC sözleşmesi: istemci stub'ları buradan gelir -->
    <ProjectReference Include="..\Booster.Authorization.Contracts\Booster.Authorization.Contracts.csproj" />

    <ProjectReference Include="..\..\..\CommonInternal\Booster.Auth.Manager\Booster.Auth.Manager.csproj" />
  </ItemGroup>

</Project>
