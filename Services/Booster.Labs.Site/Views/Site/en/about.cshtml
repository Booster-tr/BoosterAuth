@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">@m.T("nav.about")</span>
                <h1 class="reveal reveal-d1">We build secure technology that stays simple and truly yours.</h1>
                <p class="lead reveal reveal-d2">
                    Boosters Labs is the software team behind <strong>Boosters Auth</strong>, our enterprise
                    identity and authorization software, and the game <strong>Block Boosters</strong>. We bring
                    the same engineering rigor to enterprise products and to games alike.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/products">@m.T("nav.products")</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs emblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="eyebrow">Who we are</span>
                <h2 class="mt-2">A small team with a high standard</h2>
                <p class="lead mt-2">
                    Boosters Labs is a software studio based in Turkey. Security, simplicity and letting the
                    customer own their technology sit at the center of our work. We design our products so your
                    data and your infrastructure stay with you.
                </p>
                <ul class="ticks mt-3">
                    <li>We build an enterprise identity and authorization platform.</li>
                    <li>We create games for players of every age.</li>
                    <li>We put on-prem and offline scenarios first.</li>
                </ul>
            </div>
            <div class="split-media reveal reveal-d1">
                <img class="hero-mark" src="~/img/mark-light-512.png" alt="Boosters Labs emblem" width="280" height="280" />
            </div>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Direction</span>
            <h2 class="reveal reveal-d1">Our mission and vision</h2>
        </div>
        <div class="grid grid-2 mt-4">
            <article class="card reveal">
                <span class="pill pill-gold">Mission</span>
                <h3 class="mt-2">Make trust the default</h3>
                <p>
                    To meet the identity and authorization needs of organizations with software that is
                    understandable, standards compliant and entirely under their own control — making
                    technology secure without making it complex.
                </p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="pill pill-gold">Vision</span>
                <h3 class="mt-2">Products that are yours and built to last</h3>
                <p>
                    To offer products organizations can run with confidence for years, owned by them and free
                    of dependence on an outside provider — repeating the same quality in enterprise software
                    and in games, sustainably.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Our values</span>
            <h2 class="reveal reveal-d1">The principles that shape how we work</h2>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Security first</h3>
                <p>From design to deployment, security is the default — never an afterthought.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
                <h3>Simplicity</h3>
                <p>We reduce complexity instead of hiding it. Understandable products, predictable behavior.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></span>
                <h3>Technology you own</h3>
                <p>With on-prem and offline options, you keep full control of your data and infrastructure.</p>
            </article>
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 7L9 18l-5-5"/></svg></span>
                <h3>Quality and continuity</h3>
                <p>We build for what works over the long run, not for the quick shortcut.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>User privacy</h3>
                <p>Data protection is an inseparable part of our products, not an add-on.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg></span>
                <h3>Beside the customer</h3>
                <p>We stay with you after setup, answering your questions clearly and directly.</p>
            </article>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">What we do</span>
            <h2 class="reveal reveal-d1">Two fields, one standard</h2>
        </div>
        <div class="grid grid-2 mt-4">
            <article class="card reveal">
                <span class="pill pill-gold">Enterprise software</span>
                <h3 class="mt-2">Boosters Auth</h3>
                <p>
                    A multi-tenant OIDC/OAuth2 identity provider with OpenFGA-based authorization.
                    Runs on-prem, licensed offline.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/products/boosters-auth">@m.T("cta.details")</a>
                </div>
            </article>
            <article class="card reveal reveal-d1">
                <span class="pill pill-gold">Game</span>
                <h3 class="mt-2">Block Boosters</h3>
                <p>
                    From the Boosters Labs game studio: a fast, enjoyable puzzle/action experience
                    designed for players of every age.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/games/block-boosters">@m.T("cta.details")</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Let's work together</h2>
            <p class="lead">Reach out to talk about our products, our games, or partnership opportunities.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/products">@m.T("nav.products")</a>
            </div>
        </div>
    </div>
</section>
