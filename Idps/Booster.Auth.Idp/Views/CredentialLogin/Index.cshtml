@model CredentialLoginCommand
@{
    Layout = "_AuthLayout";

    var errorCount = ViewData.ModelState.AllErrors().Count;

    // Hata sayısı başlığın başına yazılır: ekran okuyucu kullanıcısı POST'un
    // başarısız olduğunu, sayfadan herhangi bir şey duymadan önce öğrenir.
    ViewData["Title"] = errorCount > 0
        ? T["Login.PageTitleWithErrors", errorCount].Value
        : T["Login.PageTitle"].Value;

    ViewData["BrandHeadline"] = T["Login.BrandHeadline"].Value;
    ViewData["BrandLead"] = T["Login.BrandLead"].Value;

    // Hangi kimlik turlerinin kabul edildigi HAVUZ POLITIKASINDAN gelir;
    // controller ViewData ile tasir. Sabit metin yazilsaydi yalnizca e-posta
    // kabul eden bir kiracida kullanici telefon girmeye davet edilirdi.
    var identifier = ViewData["IdentifierField"] as IdentifierField ?? IdentifierField.From([IdentifierType.Email]);

    var identifierInvalid = ViewData.ModelState.HasError(nameof(Model.Identifier));
    var passwordInvalid = ViewData.ModelState.HasError(nameof(Model.Password));

}

<section class="auth-card">
    <header class="auth-card__header">
        <h1 class="auth-card__title">@T["Login.Heading"]</h1>
        <p class="auth-card__subtitle">@T["Login.Subtitle"]</p>
    </header>

    <partial name="_ValidationSummary" />

    @* Gerçek route CredentialLoginController üzerindeki [HttpPost("/ui/login")]'dir.
       Gateway path prefix'i Url.Idp tarafından eklenir. *@
    <form method="post" action="@Url.Idp("/ui/login")" class="auth-form"
          data-auth-form asp-antiforgery="false">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InteractionKey" />
        <input type="hidden" asp-for="ProviderType" value="@(string.IsNullOrEmpty(Model.ProviderType) ? "local" : Model.ProviderType)" />

        @* --- Kimlik --------------------------------------------------------- *@
        <div class="auth-field auth-field--icon @(identifierInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Identifier">@T[identifier.LabelKey]</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <circle cx="10" cy="6.75" r="3.25" stroke="currentColor" stroke-width="1.6" />
                        <path d="M3.75 16.25c0-2.9 2.8-4.75 6.25-4.75s6.25 1.85 6.25 4.75"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>

                @* Tip ve otomatik doldurma POLİTİKADAN gelir: yalnızca tek tür
                   kabul ediliyorsa ona özelleşir, karışıksa nötr kalır.
                   type="email" sabitlenseydi telefonla da girilebilen bir alanda
                   tarayıcı geçerli değeri reddederdi. *@
                <input class="auth-field__input" asp-for="Identifier" type="@identifier.InputType"
                       autocomplete="@identifier.AutoComplete" inputmode="@identifier.InputMode"
                       placeholder="@T[identifier.PlaceholderKey]"
                       autocapitalize="none" autocorrect="off"
                       spellcheck="false" enterkeyhint="next" required data-initial-focus
                       aria-describedby="Identifier-error Identifier-hint"
                       aria-invalid="@(identifierInvalid ? "true" : null)" />
            </div>

            <p class="auth-field__hint" id="Identifier-hint">@T[identifier.HintKey]</p>

            <partial name="_FieldError" model="@nameof(Model.Identifier)" />
        </div>

        @* --- Parola --------------------------------------------------------- *@
        <div class="auth-field auth-field--icon auth-field--action @(passwordInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Password">@T["Login.PasswordLabel"]</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="4" y="8.5" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M7 8.5V6.25a3 3 0 1 1 6 0V8.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" />
                    </svg>
                </span>

                <input class="auth-field__input" asp-for="Password" type="password"
                       autocomplete="current-password" autocapitalize="none" spellcheck="false"
                       enterkeyhint="go" required data-caps-warn
                       aria-describedby="Password-error Password-caps"
                       aria-invalid="@(passwordInvalid ? "true" : null)" />

                @* type="button" ZORUNLU: aksi hâlde form içindeki ilk buton olarak
                   varsayılan submit olur ve Enter tuşu giriş yerine parolayı gösterir.
                   Sunucuda hidden render edilir; JS açar -> JS kapalıyken ölü kontrol yok.
                   aria-pressed kullanılmaz; erişilebilir ad değişir. *@
                <button type="button" class="auth-toggle" hidden
                        data-pw-toggle aria-controls="Password"
                        data-label-show="@T["Common.ShowPassword"]" data-label-hide="@T["Common.HidePassword"]"
                        aria-label="@T["Common.ShowPassword"]" title="@T["Common.ShowPassword"]">
                    <svg class="auth-toggle__icon auth-toggle__icon--on" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1.75 10S4.75 4.75 10 4.75 18.25 10 18.25 10 15.25 15.25 10 15.25 1.75 10 1.75 10Z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <svg class="auth-toggle__icon auth-toggle__icon--off" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4.2 5.4C2.6 6.8 1.75 10 1.75 10S4.75 15.25 10 15.25c1.4 0 2.6-.37 3.65-.93M8.1 5.1c.6-.15 1.24-.23 1.9-.23 5.25 0 8.25 5.13 8.25 5.13s-.85 1.5-2.35 2.9"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8.3 8.3a2.4 2.4 0 0 0 3.4 3.4M3 3l14 14"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            @* Uyarıdır, hata değil: canlı bölge kullanılmaz — klavye kilidi durumu
               zaten işletim sistemi düzeyinde duyurulur. *@
            <p class="auth-note auth-note--warn" id="Password-caps" hidden>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 2.25 14.25 13.5H1.75L8 2.25Z" stroke="currentColor" stroke-width="1.5"
                          stroke-linejoin="round" />
                    <path d="M8 6.75v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="8" cy="11.3" r="0.75" fill="currentColor" />
                </svg>
                @T["Common.CapsLockOn"]
            </p>

            <partial name="_FieldError" model="@nameof(Model.Password)" />
        </div>

        <div class="auth-form__actions">
            <button type="submit" class="auth-btn auth-btn--primary auth-btn--block"
                    data-submit-guard data-label-busy="@T["Login.Busy"]">
                <span class="auth-btn__spinner" aria-hidden="true"></span>
                <span class="auth-btn__label">@T["Login.Submit"]</span>
            </button>
        </div>
    </form>

    @* --- Diğer giriş yöntemleri ---------------------------------------------
       Federasyon bağlantıları <a> elemanıdır, <button> değil: form içinde
       ikinci bir name="ProviderType" submit butonu "local,google" gönderirdi.
       Harici challenge akışının doğru semantiği zaten GET -> 302'dir. *@

    @{
        var passwordlessMethods = ViewData["PasswordlessMethods"] as List<PasswordlessMethod> ?? [];
        var federationMethods = ViewData["FederationMethods"] as List<FederationMethod> ?? [];
        var interactionKey = Uri.EscapeDataString(Model.InteractionKey ?? string.Empty);
        var hasAlternatives = passwordlessMethods.Count > 0 || federationMethods.Count > 0;
    }

    @* Ayrac YALNIZCA altinda en az bir secenek varsa cizilir; bos bir
       "veya diger yontemlerle" ayraci 1.3.1 kusurudur. *@
    @if (hasAlternatives)
    {
        <h2 class="auth-divider"><span>@T["Login.OtherMethods"]</span></h2>
    }

    @* Federasyon baglantilari <a> elemanidir, <button> degil: form icinde
       ikinci bir name="ProviderType" submit butonu "local,google" gonderirdi.
       Harici challenge akisinin dogru semantigi zaten GET -> 302. *@
    @if (federationMethods.Count > 0)
    {
        <div class="auth-fed">
            @foreach (var method in federationMethods)
            {
                <a class="auth-btn auth-btn--fed"
                   href="@Url.Idp($"/ui/external/challenge?interaction_key={interactionKey}&provider={Uri.EscapeDataString(method.Key)}")">
                    <span class="auth-btn__brand" aria-hidden="true">
                        <partial name="_FederationIcon" model="method.ProviderType" />
                    </span>
                    @* Ad ceviri anahtari DEGIL: kurumsal bir saglayicinin adini
                       biz bilemeyiz, onu havuz sahibi yazar. *@
                    <span class="auth-btn__label">@method.DisplayName</span>
                </a>
            }
        </div>
    }

    @* Yalnizca havuzun izin verdigi yontemler gorunur; izinsiz bir dugme
       kullaniciyi sebebi anlasilmayan bir hata ekranina gotururdu. *@
    @if (passwordlessMethods.Count > 0)
    {
        <div class="auth-alt">
            @foreach (var method in passwordlessMethods)
            {
                <a class="auth-btn auth-btn--secondary auth-btn--block"
                   href="@Url.Idp($"/ui/passwordless?interaction_key={interactionKey}&provider={Uri.EscapeDataString(method.ProviderType)}")">
                    <span class="auth-btn__label">@T[method.LabelKey]</span>
                </a>
            }
        </div>
    }

    <p class="auth-card__footnote">
        <a class="auth-link auth-link--standalone"
           href="@Url.Idp($"/ui/forgot-password?interaction_key={Uri.EscapeDataString(Model.InteractionKey ?? string.Empty)}")">@T["Login.ForgotPassword"]</a>
    </p>

    <footer class="auth-card__footer">
        @T["Login.NoAccount"]
        <a class="auth-link auth-link--standalone"
           href="@Url.Idp($"/register?interaction_key={Uri.EscapeDataString(Model.InteractionKey ?? string.Empty)}")">@T["Login.SignUp"]</a>
    </footer>
</section>
