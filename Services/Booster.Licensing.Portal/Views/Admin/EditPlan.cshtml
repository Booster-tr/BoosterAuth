@model PlanForm
@{ ViewData["Title"] = Model.Id is null ? "Yeni plan" : "Planı düzenle"; }
<h1>@ViewData["Title"]</h1>
<form method="post" class="card form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert"></div>
    <div class="row">
        <label>Kod <small class="muted">lisansa yazılır</small><input asp-for="Code" required /></label>
        <label>Ad <input asp-for="Name" required /></label>
    </div>
    <span asp-validation-for="Code" class="field-error"></span>
    <span asp-validation-for="Name" class="field-error"></span>
    <div class="row">
        <label>Kullanıcı <input asp-for="MaxUsers" type="number" min="1" /></label>
        <label>Havuz <input asp-for="MaxPools" type="number" min="1" /></label>
        <label>Uygulama <input asp-for="MaxClients" type="number" min="1" /></label>
    </div>
    <div class="row">
        <label>Süre (ay) <input asp-for="DurationMonths" type="number" min="1" /></label>
        <label>Fiyat <input asp-for="Price" type="number" min="0" step="0.01" /></label>
        <label>Para birimi <input asp-for="Currency" maxlength="3" /></label>
        <label>Sıra <input asp-for="SortOrder" type="number" /></label>
    </div>
    <label style="flex-direction:row;align-items:center;gap:.5rem"><input asp-for="IsActive" type="checkbox" /> Aktif (satışta)</label>
    <div class="actions">
        <a class="btn btn-ghost" href="/admin/planlar">Vazgeç</a>
        <button class="btn btn-primary" type="submit">Kaydet</button>
    </div>
</form>
