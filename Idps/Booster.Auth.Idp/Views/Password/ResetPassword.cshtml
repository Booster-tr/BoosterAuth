@model ResetPasswordCommand
@{
    Layout = "_AuthLayout";

    var errorCount = ViewData.ModelState.AllErrors().Count;

    ViewData["Title"] = errorCount > 0
        ? $"{errorCount} hata – Yeni parola · Booster Auth"
        : "Yeni parola · Booster Auth";

    ViewData["MainModifier"] = "auth-main--reset";
    ViewData["BrandHeadline"] = "Yeni parolanızı belirleyin.";
    ViewData["BrandLead"] = "Kod yalnızca bu tarayıcıda geçerlidir. Daha önce kullandığınız parolaları tekrar seçemeyebilirsiniz; kurumunuzun politikası bunu belirler.";

    var passwordInvalid = ViewData.ModelState.HasError(nameof(Model.Password));
    var confirmInvalid = ViewData.ModelState.HasError(nameof(Model.PasswordConfirm));
}

<section class="auth-card">
    <header class="auth-card__header">
        <h1 class="auth-card__title">Yeni parola belirleyin</h1>
        <p class="auth-card__subtitle">Size gönderdiğimiz kodu girin ve yeni parolanızı belirleyin.</p>
    </header>

    <partial name="_ValidationSummary" />

    @* Gerçek route PasswordController üzerindeki [HttpPost("/ui/reset-password")]'dır. *@
    <form method="post" action="@Url.Idp("/ui/reset-password")" class="auth-form"
          data-auth-form asp-antiforgery="false">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InteractionKey" />

        @* --- Doğrulama kodu ---------------------------------------------------
           Kod bu ekrandan girilir, bağlantıyla gelinmez: böylece yalnızca posta
           kutusuna erişen biri akışı sürdüremez — kayıt, sıfırlamayı başlatan
           tarayıcının etkileşim anahtarına bağlıdır. *@
        <div class="auth-field auth-field--icon @(ViewData.ModelState.HasError(nameof(Model.Code)) ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Code">Doğrulama kodu</label>
            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="2.75" y="5.25" width="14.5" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M6 10h1.5M9.25 10h1.5M12.5 10H14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="Code" type="text"
                       inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                       autocapitalize="none" spellcheck="false" enterkeyhint="next"
                       required data-validate data-initial-focus
                       data-msg-required="Lütfen size gönderilen kodu girin."
                       aria-describedby="Code-error Code-hint"
                       aria-invalid="@(ViewData.ModelState.HasError(nameof(Model.Code)) ? "true" : null)" />
            </div>
            <p class="auth-field__hint" id="Code-hint">Altı haneli kod 15 dakika geçerlidir.</p>
            <partial name="_FieldError" model="@nameof(Model.Code)" />
        </div>

        @* --- Yeni parola ------------------------------------------------------ *@
        <div class="auth-field auth-field--icon auth-field--action @(passwordInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Password">Yeni parola</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="4" y="8.5" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M7 8.5V6.25a3 3 0 1 1 6 0V8.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="Password" type="password"
                       autocomplete="new-password" autocapitalize="none" spellcheck="false"
                       enterkeyhint="next" required data-validate data-caps-warn data-rule="password"
                       data-msg-required="Lütfen yeni bir parola belirleyin."
                       data-msg-rule="Parolanız aşağıdaki koşulların tümünü sağlamalıdır."
                       aria-describedby="Password-error Password-caps Password-hint"
                       aria-invalid="@(passwordInvalid ? "true" : null)" />

                <button type="button" class="auth-toggle" hidden
                        data-pw-toggle aria-controls="Password"
                        data-label-show="Parolayı göster" data-label-hide="Parolayı gizle"
                        aria-label="Parolayı göster" title="Parolayı göster">
                    <svg class="auth-toggle__icon auth-toggle__icon--on" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1.75 10S4.75 4.75 10 4.75 18.25 10 18.25 10 15.25 15.25 10 15.25 1.75 10 1.75 10Z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <svg class="auth-toggle__icon auth-toggle__icon--off" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4.2 5.4C2.6 6.8 1.75 10 1.75 10S4.75 15.25 10 15.25c1.4 0 2.6-.37 3.65-.93M8.1 5.1c.6-.15 1.24-.23 1.9-.23 5.25 0 8.25 5.13 8.25 5.13s-.85 1.5-2.35 2.9"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8.3 8.3a2.4 2.4 0 0 0 3.4 3.4M3 3l14 14"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <p class="auth-field__hint" id="Password-hint" data-nojs-hint>
                En az 8 karakter olmalı; büyük harf, küçük harf ve rakam içermeli, boşluk içermemelidir.
            </p>

            <p class="auth-note auth-note--warn" id="Password-caps" hidden>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 2.25 14.25 13.5H1.75L8 2.25Z" stroke="currentColor" stroke-width="1.5"
                          stroke-linejoin="round" />
                    <path d="M8 6.75v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="8" cy="11.3" r="0.75" fill="currentColor" />
                </svg>
                Caps Lock açık.
            </p>

            <div class="auth-meter" data-strength-for="Password" hidden>
                <div class="auth-meter__head">
                    <span>Parola gücü</span>
                    <span class="auth-meter__level"></span>
                </div>

                <div class="auth-meter__track" aria-hidden="true">
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                </div>

                <ul class="auth-reqs" role="list" id="Password-reqs">
                    <li class="auth-reqs__item" data-req="len" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az 8 karakter</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="upper" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir büyük harf</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="lower" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir küçük harf</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="digit" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir rakam</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                </ul>
            </div>

            <p class="u-visually-hidden" id="Password-live" role="status"
               aria-live="polite" aria-atomic="true"></p>

            <partial name="_FieldError" model="@nameof(Model.Password)" />
        </div>

        @* --- Parola tekrar ---------------------------------------------------- *@
        <div class="auth-field auth-field--icon auth-field--action @(confirmInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="PasswordConfirm">Yeni parola (tekrar)</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="4" y="8.5" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M7 8.5V6.25a3 3 0 1 1 6 0V8.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="PasswordConfirm" type="password"
                       autocomplete="new-password" autocapitalize="none" spellcheck="false"
                       enterkeyhint="done" required data-validate data-caps-warn
                       data-match="Password"
                       data-msg-required="Lütfen parolanızı tekrar girin."
                       data-msg-match="Parolalar eşleşmiyor."
                       aria-describedby="PasswordConfirm-error"
                       aria-invalid="@(confirmInvalid ? "true" : null)" />

                <button type="button" class="auth-toggle" hidden
                        data-pw-toggle aria-controls="PasswordConfirm"
                        data-label-show="Parolayı göster" data-label-hide="Parolayı gizle"
                        aria-label="Parolayı göster" title="Parolayı göster">
                    <svg class="auth-toggle__icon auth-toggle__icon--on" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1.75 10S4.75 4.75 10 4.75 18.25 10 18.25 10 15.25 15.25 10 15.25 1.75 10 1.75 10Z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <svg class="auth-toggle__icon auth-toggle__icon--off" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4.2 5.4C2.6 6.8 1.75 10 1.75 10S4.75 15.25 10 15.25c1.4 0 2.6-.37 3.65-.93M8.1 5.1c.6-.15 1.24-.23 1.9-.23 5.25 0 8.25 5.13 8.25 5.13s-.85 1.5-2.35 2.9"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8.3 8.3a2.4 2.4 0 0 0 3.4 3.4M3 3l14 14"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <partial name="_FieldError" model="@nameof(Model.PasswordConfirm)" />
        </div>

        <div class="auth-form__actions">
            <button type="submit" class="auth-btn auth-btn--primary auth-btn--block"
                    data-submit-guard data-busy-label="Güncelleniyor…">
                <span class="auth-btn__spinner" aria-hidden="true"></span>
                <span class="auth-btn__label">Parolamı güncelle</span>
            </button>
        </div>
    </form>
</section>
