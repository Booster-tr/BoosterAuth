@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">Oyun studyosu</span>
                <h1 class="reveal reveal-d1">Oyunlarimiz</h1>
                <p class="lead reveal reveal-d2">
                    Boosters Labs oyun studyosu; kurumsal yazilimda kullandigimiz ayni muhendislik
                    titizligini oyunlara tasir. Hizli, keyifli ve her yastan oyuncuya hitap eden
                    deneyimler tasarliyoruz.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/games/block-boosters">Block Boosters</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs amblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="pill pill-gold">Oyun</span>
                <h2 class="mt-2">Block Boosters</h2>
                <p class="lead">
                    Sezgisel kontroller, tatmin edici mekanikler ve giderek zorlasan bolumlerle
                    kolayca kavranan ama birakmasi zor bir bulmaca/aksiyon deneyimi.
                </p>
                <ul class="ticks mt-2">
                    <li>Her yastan oyuncuya uygun, aile dostu tasarim</li>
                    <li>Temiz ve modern gorsellik</li>
                    <li>Reklamsiz, adil ve akici oyun hissi</li>
                </ul>
                <div class="actions mt-3">
                    <a class="btn btn-primary" href="/@lang/games/block-boosters">@m.T("cta.details")</a>
                </div>
            </div>
            <div class="split-media reveal reveal-d1">
                <div class="center">
                    <img class="hero-mark" src="~/img/mark-light-512.png" alt="Block Boosters" width="220" height="220" />
                    <h3 class="mt-3">Block Boosters</h3>
                    <p>Bulmaca / aksiyon · Yakinda</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Yol haritasi</span>
            <h2 class="reveal reveal-d1">Daha fazlasi yolda</h2>
            <p class="lead center reveal reveal-d2">
                Studyomuzda yeni projeler uzerinde calismaya devam ediyoruz. Sira disi fikirlerle
                donup gelmeyi seviyoruz; ilk haberi alanlardan olmak isterseniz bize yazin.
            </p>
            <div class="actions center mt-3 reveal reveal-d3">
                <a class="btn btn-dark" href="/@lang/contact">@m.T("nav.contact")</a>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Birlikte oynayalim</h2>
            <p class="lead">Oyunlarimiz, is birligi ya da yayincilik firsatlari icin bize ulasin.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/about">@m.T("nav.about")</a>
            </div>
        </div>
    </div>
</section>
