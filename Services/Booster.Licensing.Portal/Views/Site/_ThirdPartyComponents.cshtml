    (string Name, string License, string Spdx)[] web =
    [
        ("Next.js, React, React DOM", "MIT", "MIT"),
        ("Radix UI, @tanstack/react-query, @tanstack/react-table, @xyflow/react", "MIT", "MIT"),
        ("next-intl, next-themes, openid-client, iron-session, zod, react-hook-form, @hookform/resolvers", "MIT", "MIT"),
        ("sonner, vaul, clsx, tailwind-merge, tw-animate-css", "MIT", "MIT"),
        ("class-variance-authority", "Apache-2.0", "Apache-2.0"),
        ("lucide-react", "ISC", "ISC"),
    ];
}
<h2 id="@(en ? "images" : "imajlar")">@(en ? "Container images" : "Konteyner imajları")</h2>
<p>@(en
    ? "The install package's docker-compose.yml pulls these images from their official sources. Booster Auth's own services use the images below as their base."
    : "Kurulum paketindeki docker-compose.yml bu imajları resmî kaynaklarından çeker. Booster Auth servislerinin kendi imajları da aşağıdaki taban imajları kullanır.")</p>
<div class="table-scroll">
<table>
    <thead><tr><th>@(en ? "Component" : "Bileşen")</th><th>@(en ? "Version" : "Sürüm")</th><th>@(en ? "License" : "Lisans")</th></tr></thead>
    <tbody>
    @foreach (var c in images)
    {
        <tr><td><a href="@c.Url" rel="noopener">@c.Name</a></td><td>@c.Version</td><td><a href="@Spdx(c.Spdx)" rel="noopener">@c.License</a></td></tr>
    }
    </tbody>
</table>
</div>

<h2 id="@(en ? "packages" : "paketler")">@(en ? ".NET libraries (services)" : ".NET kütüphaneleri (servisler)")</h2>
<div class="table-scroll">
<table>
    <thead><tr><th>@(en ? "Component" : "Bileşen")</th><th>@(en ? "License" : "Lisans")</th></tr></thead>
    <tbody>
    @foreach (var c in packages)
    {
        <tr><td><a href="@c.Url" rel="noopener">@c.Name</a></td><td><a href="@Spdx(c.Spdx)" rel="noopener">@c.License</a></td></tr>
    }
    </tbody>
</table>
</div>

<h2 id="@(en ? "panel" : "panel")">@(en ? "Admin console (web)" : "Yönetim paneli (web)")</h2>
<div class="table-scroll">
<table>
    <thead><tr><th>@(en ? "Component" : "Bileşen")</th><th>@(en ? "License" : "Lisans")</th></tr></thead>
    <tbody>
    @foreach (var c in web)
    {
        <tr><td>@c.Name</td><td><a href="@Spdx(c.Spdx)" rel="noopener">@c.License</a></td></tr>
    }
    </tbody>
</table>
</div>
