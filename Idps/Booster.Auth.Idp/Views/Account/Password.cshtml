@model Booster.Auth.Idp.Controllers.AccountPageModel
@using Booster.Auth.Idp.Controllers
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Password.Heading"].Value;
    var passwordPolicy = ViewData["PasswordPolicy"] as Booster.Auth.Database.Models.PasswordPolicyData;
}

<section class="auth-card">
    <header class="auth-card__header">
        <h1 class="auth-card__title">@T["Password.Heading"]</h1>
        <p class="auth-card__subtitle">@T["Password.Subtitle"]</p>
    </header>

    <partial name="_ValidationSummary" />

    <form method="post" action="@Url.Idp("/ui/account/password")" class="auth-form" data-auth-form asp-antiforgery="false">
        <partial name="_Hidden" model="Model" />
        <partial name="_Field" model="@(new AccountFieldModel("CurrentPassword", T["Password.Current"].Value, Type: "password", Autocomplete: "current-password", Autofocus: true))" />
        <partial name="_Field" model="@(new AccountFieldModel("NewPassword", T["Password.New"].Value, Type: "password", Autocomplete: "new-password"))" />
        <partial name="_PasswordRules" model="passwordPolicy" />
        <partial name="_Field" model="@(new AccountFieldModel("NewPasswordConfirm", T["Password.Confirm"].Value, Type: "password", Autocomplete: "new-password"))" />
        <div class="auth-form__actions">
            <button type="submit" class="auth-btn auth-btn--primary auth-btn--block" data-submit-guard>
                <span class="auth-btn__spinner" aria-hidden="true"></span>
                <span class="auth-btn__label">@T["Password.Submit"]</span>
            </button>
        </div>
    </form>

    <partial name="_Back" model="Model" />
</section>
