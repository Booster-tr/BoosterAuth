@model IReadOnlyList<string>
@using Booster.Licensing.Portal.Services
@{
    ViewData["Title"] = "İndir";
    ViewData["Wide"] = true;
}
<section class="site-head">
    <h1>Booster Auth'u indirin</h1>
    <p class="lead">Docker Compose kurulum paketi: tek makinede tüm servisler, veritabanı ve yönetim paneli.</p>
    <p><a class="btn btn-primary btn-lg" href="/indir/@InstallPackage.FileName" data-download>@InstallPackage.FileName indir</a></p>
    <p class="muted small">Gereksinimler: Docker Engine 24+ ve Docker Compose v2 (Windows / macOS: Docker Desktop), en az 4 GB boş bellek.</p>
</section>

<section class="card">
    <h2>Kurulum</h2>
    <ol class="how-steps">
        <li>Zip dosyasını açın ve klasöre geçin: <code>cd booster-auth</code></li>
        <li>Kurulum betiğini çalıştırın; adresleri sorar, parola ve anahtarları üretir:
            <pre class="code">./kurulum.sh                                         # Linux / macOS
powershell -ExecutionPolicy Bypass -File .\kurulum.ps1  # Windows</pre></li>
        <li>Başlatın: <pre class="code">docker compose up -d</pre></li>
        <li>Yönetim paneline <b>admin</b> kullanıcısı ve betiğin gösterdiği ilk parolayla girin.</li>
        <li><b>Sistem &gt; Lisans</b> ekranında <b>Lisans al</b> butonuna basın; bu portalda deneme ya da ücretli lisans alıp
            anahtarı panele yapıştırın.</li>
    </ol>
    <p class="muted">Booster Auth adresi (ör. <code>auth.firma.com</code>) lisansınızdaki domain'lerden biri olmalıdır. Yerel
        deneme için <code>hosts</code> dosyasına <code>127.0.0.1 auth.firma.com</code> ekleyebilirsiniz. Ayrıntılar paketteki
        <code>BENIOKU.md</code> dosyasındadır.</p>
</section>

<section class="card">
    <h2>Paketin içeriği</h2>
    <ul class="files">
        @foreach (var f in Model)
        {
            <li><code>booster-auth/@f</code></li>
        }
    </ul>
</section>
