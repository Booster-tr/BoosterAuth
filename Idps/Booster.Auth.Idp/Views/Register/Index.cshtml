@model RegisterCommand
@{
    Layout = "_AuthLayout";

    var errorCount = ViewData.ModelState.AllErrors().Count;

    ViewData["Title"] = errorCount > 0
        ? $"{errorCount} hata – Hesap oluşturun · Booster Auth"
        : "Hesap oluşturun · Booster Auth";

    ViewData["MainModifier"] = "auth-main--register";
    ViewData["BrandHeadline"] = "Bir hesap açın, her uygulamada geçerli olsun.";
    ViewData["BrandLead"] = "Booster Auth hesabınız, kurumunuzun yetkilendirdiği tüm uygulamalarda tek kimliğiniz olur.";

    var displayNameInvalid = ViewData.ModelState.HasError(nameof(Model.DisplayName));
    var userNameInvalid = ViewData.ModelState.HasError(nameof(Model.UserName));
    var emailInvalid = ViewData.ModelState.HasError(nameof(Model.Email));
    var phoneInvalid = ViewData.ModelState.HasError(nameof(Model.Phone))
                       || ViewData.ModelState.HasError(nameof(Model.PhoneCountry));
    var passwordInvalid = ViewData.ModelState.HasError(nameof(Model.Password));
    var confirmInvalid = ViewData.ModelState.HasError(nameof(Model.PasswordConfirm));

    // Hangi kimlik alanının zorunlu olduğu istemci politikasına bağlıdır
    // (ClientData.Login.AllowedIdentifiers) ve view bu politikayı göremez.
    // Controller isterse ViewData ile bildirir; varsayılan en yaygın kurulumdur.
    // Bu olmadan, e-postanın isteğe bağlı olduğu bir kiracıda tarayıcı formu
    // gereksiz yere bloke ederdi.
    var emailRequired = ViewData["EmailRequired"] as bool? ?? true;
    var userNameRequired = ViewData["UserNameRequired"] as bool? ?? false;
}

<section class="auth-card">
    <header class="auth-card__header">
        <h1 class="auth-card__title">Hesap oluşturun</h1>
        <p class="auth-card__subtitle">Birkaç adımda hesabınızı oluşturun, kaldığınız yerden devam edin.</p>
    </header>

    <partial name="_ValidationSummary" />

    @* Gerçek route RegisterController üzerindeki [HttpPost("/register")]'dır. *@
    <form method="post" action="@Url.Idp("/register")" class="auth-form"
          data-auth-form asp-antiforgery="false">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InteractionKey" />

        <p class="auth-field__hint">Aksi belirtilmedikçe tüm alanlar zorunludur.</p>

        @* --- Ad soyad ------------------------------------------------------- *@
        <div class="auth-field auth-field--icon @(displayNameInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="DisplayName">Ad soyad</label>
            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <circle cx="10" cy="6.75" r="3.25" stroke="currentColor" stroke-width="1.6" />
                        <path d="M3.75 16.25c0-2.9 2.8-4.75 6.25-4.75s6.25 1.85 6.25 4.75"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="DisplayName" type="text"
                       autocomplete="name" autocapitalize="words" enterkeyhint="next"
                       maxlength="300" required data-validate
                       data-msg-required="Lütfen adınızı ve soyadınızı girin."
                       aria-describedby="DisplayName-error DisplayName-hint"
                       aria-invalid="@(displayNameInvalid ? "true" : null)" />
            </div>
            <p class="auth-field__hint" id="DisplayName-hint">Uygulamalarda bu isimle görüneceksiniz.</p>
            <partial name="_FieldError" model="@nameof(Model.DisplayName)" />
        </div>

        @* --- Kullanıcı adı --------------------------------------------------- *@
        <div class="auth-field auth-field--icon @(userNameInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="UserName">
                Kullanıcı adı
                @if (!userNameRequired)
                {
                    <span class="auth-field__optional">(isteğe bağlı)</span>
                }
            </label>
            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <path d="M6.25 5.5h7.5M6.25 10h7.5M6.25 14.5h4.5" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="UserName" type="text"
                       autocomplete="username" autocapitalize="none" autocorrect="off"
                       spellcheck="false" enterkeyhint="next" maxlength="100"
                       required="@(userNameRequired ? "required" : null)"
                       data-msg-required="Lütfen bir kullanıcı adı belirleyin."
                       data-validate data-username data-rule="username"
                       data-msg-rule="Kullanıcı adı 3-100 karakter olmalı; yalnızca harf, rakam, nokta, alt çizgi ve tire içerebilir."
                       aria-describedby="UserName-error UserName-hint"
                       aria-invalid="@(userNameInvalid ? "true" : null)" />
            </div>
            <p class="auth-field__hint auth-note" id="UserName-hint">
                3-100 karakter. Harf, rakam, nokta, alt çizgi ve tire kullanabilirsiniz.
            </p>
            <partial name="_FieldError" model="@nameof(Model.UserName)" />
        </div>

        @* --- E-posta --------------------------------------------------------- *@
        <div class="auth-field auth-field--icon @(emailInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Email">
                E-posta
                @if (!emailRequired)
                {
                    <span class="auth-field__optional">(isteğe bağlı)</span>
                }
            </label>
            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="2.75" y="4.5" width="14.5" height="11" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="m3.5 6 6.5 4.75L16.5 6" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="Email" type="email" inputmode="email"
                       autocomplete="email" autocapitalize="none" autocorrect="off"
                       spellcheck="false" enterkeyhint="next" maxlength="320"
                       required="@(emailRequired ? "required" : null)"
                       data-validate data-rule="email"
                       data-msg-required="Lütfen e-posta adresinizi girin."
                       data-msg-rule="Geçerli bir e-posta adresi girin. Örnek: ad@@ornek.com"
                       aria-describedby="Email-error Email-hint"
                       aria-invalid="@(emailInvalid ? "true" : null)" />
            </div>
            <p class="auth-field__hint" id="Email-hint">Hesabınızla ilgili bildirimler bu adrese gönderilir.</p>
            <partial name="_FieldError" model="@nameof(Model.Email)" />
        </div>

        @* --- Telefon ---------------------------------------------------------
           fieldset + legend kullanılır (role="group" değil): JAWS ve NVDA legend'ı
           içerdiği HER kontrolün duyurusuna ekler, böylece kullanıcı alana geriye
           doğru sekerek girdiğinde de bağlamı duyar. Tek başına anlamsız iki yarımı
           olan bir alanda ihtiyaç duyulan tam olarak budur. *@
        <fieldset class="auth-field @(phoneInvalid ? "auth-field--invalid" : null)">
            <legend class="auth-field__label">
                Telefon <span class="auth-field__optional">(isteğe bağlı)</span>
            </legend>

            <div class="auth-field__control">
                <div class="auth-phone__row">
                    <div class="auth-phone__country">
                        <span class="auth-phone__plus" aria-hidden="true">+</span>
                        <label class="u-visually-hidden" for="PhoneCountry">Ülke kodu</label>
                        @* "+" işareti input'un değeri değil, statik süstür: alana yalnızca
                           "90" yazılır ve PhoneCountry olarak "90" gönderilir. *@
                        <input class="auth-field__input auth-phone__code" asp-for="PhoneCountry"
                               type="text" inputmode="numeric" maxlength="4"
                               value="@(string.IsNullOrEmpty(Model.PhoneCountry) ? "90" : Model.PhoneCountry)"
                               autocomplete="tel-country-code" data-phone-country
                               aria-describedby="PhoneCountry-error Phone-hint"
                               aria-invalid="@(ViewData.ModelState.HasError(nameof(Model.PhoneCountry)) ? "true" : null)" />
                    </div>

                    <span class="auth-phone__divider" aria-hidden="true"></span>

                    <label class="u-visually-hidden" for="Phone">Telefon numarası</label>
                    <input class="auth-field__input auth-phone__number" asp-for="Phone"
                           type="tel" inputmode="numeric" maxlength="15" placeholder="5XX XXX XX XX"
                           autocomplete="tel-national" enterkeyhint="next"
                           data-phone-number data-validate data-rule="phone"
                           data-msg-rule="Telefon numarasını yalnızca rakamlarla girin."
                           aria-describedby="Phone-error Phone-hint"
                           aria-invalid="@(phoneInvalid ? "true" : null)" />
                </div>
            </div>

            <p class="auth-field__hint" id="Phone-hint">Numaranızı başında sıfır olmadan yazın.</p>
            @* İki yarımın da kendi hata satırı olmalı: yalnızca ülke kodu hatalıysa
               fieldset kırmızıya boyanıp hiçbir metin çıkmaması kabul edilemez. *@
            <partial name="_FieldError" model="@nameof(Model.PhoneCountry)" />
            <partial name="_FieldError" model="@nameof(Model.Phone)" />
        </fieldset>

        @* --- Parola ---------------------------------------------------------- *@
        <div class="auth-field auth-field--icon auth-field--action @(passwordInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="Password">Parola</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="4" y="8.5" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M7 8.5V6.25a3 3 0 1 1 6 0V8.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" />
                    </svg>
                </span>
                <input class="auth-field__input" asp-for="Password" type="password"
                       autocomplete="new-password" autocapitalize="none" spellcheck="false"
                       enterkeyhint="next" required data-validate data-caps-warn data-rule="password"
                       data-msg-required="Lütfen bir parola belirleyin."
                       data-msg-rule="Parolanız aşağıdaki koşulların tümünü sağlamalıdır."
                       aria-describedby="Password-error Password-caps Password-hint"
                       aria-invalid="@(passwordInvalid ? "true" : null)" />

                <button type="button" class="auth-toggle" hidden
                        data-pw-toggle aria-controls="Password"
                        data-label-show="Parolayı göster" data-label-hide="Parolayı gizle"
                        aria-label="Parolayı göster" title="Parolayı göster">
                    <svg class="auth-toggle__icon auth-toggle__icon--on" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1.75 10S4.75 4.75 10 4.75 18.25 10 18.25 10 15.25 15.25 10 15.25 1.75 10 1.75 10Z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <svg class="auth-toggle__icon auth-toggle__icon--off" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4.2 5.4C2.6 6.8 1.75 10 1.75 10S4.75 15.25 10 15.25c1.4 0 2.6-.37 3.65-.93M8.1 5.1c.6-.15 1.24-.23 1.9-.23 5.25 0 8.25 5.13 8.25 5.13s-.85 1.5-2.35 2.9"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8.3 8.3a2.4 2.4 0 0 0 3.4 3.4M3 3l14 14"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            @* JS kapalıyken politikayı anlatan tek kaynak. JS açılınca bu düğüm
               tamamen kaldırılır (canlı koşul listesi aynı bilgiyi taşır). *@
            <p class="auth-field__hint" id="Password-hint" data-nojs-hint>
                En az 8 karakter olmalı; büyük harf, küçük harf ve rakam içermeli, boşluk içermemelidir.
            </p>

            <p class="auth-note auth-note--warn" id="Password-caps" hidden>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 2.25 14.25 13.5H1.75L8 2.25Z" stroke="currentColor" stroke-width="1.5"
                          stroke-linejoin="round" />
                    <path d="M8 6.75v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="8" cy="11.3" r="0.75" fill="currentColor" />
                </svg>
                Caps Lock açık.
            </p>

            @* --- Güç göstergesi ---------------------------------------------
               Çubuklar tamamen dekoratiftir (aria-hidden); bilgi metinle taşınır.
               Bloğun kendisi sunucuda hidden'dır, JS açar. *@
            <div class="auth-meter" data-strength-for="Password"
                 data-context="DisplayName,UserName,Email" hidden>
                <div class="auth-meter__head">
                    <span>Parola gücü</span>
                    <span class="auth-meter__level"></span>
                </div>

                <div class="auth-meter__track" aria-hidden="true">
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                    <span class="auth-meter__seg"></span>
                </div>

                @* Durum önce METİNLE taşınır (.auth-reqs__state); renk ve işaret
                   yalnızca pekiştirmedir — SC 1.4.1. *@
                <ul class="auth-reqs" role="list" id="Password-reqs">
                    <li class="auth-reqs__item" data-req="len" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az 8 karakter</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="upper" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir büyük harf</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="lower" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir küçük harf</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                    <li class="auth-reqs__item" data-req="digit" data-met="false">
                        <span class="auth-reqs__mark" aria-hidden="true"></span>
                        <span>En az bir rakam</span>
                        <span class="u-visually-hidden auth-reqs__state">, eksik</span>
                    </li>
                </ul>

                <p class="auth-meter__tip">Noktalama işareti eklemek parolanızı daha da güçlendirir.</p>
            </div>

            @* Güç göstergesinin kendi nazik bölgesi: 500 ms geciktirilir ve
               yalnızca seviye ETİKETİ değiştiğinde yazılır. *@
            <p class="u-visually-hidden" id="Password-live" role="status"
               aria-live="polite" aria-atomic="true"></p>

            <partial name="_FieldError" model="@nameof(Model.Password)" />
        </div>

        @* --- Parola tekrar ---------------------------------------------------- *@
        <div class="auth-field auth-field--icon auth-field--action @(confirmInvalid ? "auth-field--invalid" : null)">
            <label class="auth-field__label" for="PasswordConfirm">Parola (tekrar)</label>

            <div class="auth-field__control">
                <span class="auth-field__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" focusable="false">
                        <rect x="4" y="8.5" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <path d="M7 8.5V6.25a3 3 0 1 1 6 0V8.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" />
                        <path d="m8.2 12.4 1.3 1.3 2.4-2.5" stroke="currentColor" stroke-width="1.6"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>

                @* Doğrulama stratejisi: alan ilk kez blur olana kadar hata gösterilmez
                   (kullanıcı daha yazmaya başlarken "eşleşmiyor" yakıp söndürmesin),
                   blur'dan sonra her tuş vuruşunda yeniden değerlendirilir. *@
                <input class="auth-field__input" asp-for="PasswordConfirm" type="password"
                       autocomplete="new-password" autocapitalize="none" spellcheck="false"
                       enterkeyhint="go" required data-validate data-caps-warn
                       data-match-for="Password"
                       data-msg-required="Lütfen parolanızı tekrar girin."
                       data-msg-match="Parolalar eşleşmiyor."
                       aria-describedby="PasswordConfirm-error PasswordConfirm-caps"
                       aria-invalid="@(confirmInvalid ? "true" : null)" />

                <button type="button" class="auth-toggle" hidden
                        data-pw-toggle aria-controls="PasswordConfirm"
                        data-label-show="Parolayı göster" data-label-hide="Parolayı gizle"
                        aria-label="Parolayı göster" title="Parolayı göster">
                    <svg class="auth-toggle__icon auth-toggle__icon--on" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M1.75 10S4.75 4.75 10 4.75 18.25 10 18.25 10 15.25 15.25 10 15.25 1.75 10 1.75 10Z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="10" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <svg class="auth-toggle__icon auth-toggle__icon--off" width="20" height="20"
                         viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4.2 5.4C2.6 6.8 1.75 10 1.75 10S4.75 15.25 10 15.25c1.4 0 2.6-.37 3.65-.93M8.1 5.1c.6-.15 1.24-.23 1.9-.23 5.25 0 8.25 5.13 8.25 5.13s-.85 1.5-2.35 2.9"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M8.3 8.3a2.4 2.4 0 0 0 3.4 3.4M3 3l14 14"
                              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <p class="auth-note auth-note--warn" id="PasswordConfirm-caps" hidden>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M8 2.25 14.25 13.5H1.75L8 2.25Z" stroke="currentColor" stroke-width="1.5"
                          stroke-linejoin="round" />
                    <path d="M8 6.75v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <circle cx="8" cy="11.3" r="0.75" fill="currentColor" />
                </svg>
                Caps Lock açık.
            </p>

            @* Sessiz görsel onay: canlı bölge yok, duyurulmaz. *@
            <p class="auth-note auth-note--ok" id="PasswordConfirm-ok" hidden>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" />
                    <path d="m5.5 8.2 1.7 1.7 3.3-3.6" stroke="currentColor" stroke-width="1.5"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Parolalar eşleşiyor.
            </p>

            <partial name="_FieldError" model="@nameof(Model.PasswordConfirm)" />
        </div>

        <div class="auth-form__actions">
            <button type="submit" class="auth-btn auth-btn--primary auth-btn--block"
                    data-submit-guard data-label-busy="Hesabınız oluşturuluyor…">
                <span class="auth-btn__spinner" aria-hidden="true"></span>
                <span class="auth-btn__label">Hesap oluştur</span>
            </button>

            <p class="auth-field__hint">
                Hesap oluşturarak
                <a class="auth-link" href="@Url.Idp("/terms")">Kullanım Koşulları</a>'nı ve
                <a class="auth-link" href="@Url.Idp("/privacy")">Gizlilik Politikası</a>'nı kabul etmiş olursunuz.
            </p>
        </div>
    </form>

    <footer class="auth-card__footer">
        Zaten hesabınız var mı?
        <a class="auth-link auth-link--standalone"
           href="@Url.Idp($"/ui/login?interaction_key={Uri.EscapeDataString(Model.InteractionKey ?? string.Empty)}")">Giriş yapın</a>
    </footer>
</section>
