@model Booster.Auth.Database.Models.PasswordPolicyData?
@*
    Parola kurallarını HAVUZ POLİTİKASINDAN yazar.

    Sabit metin olamaz: MinLength ve gereklilik bayrakları havuz başına değişiyor.
    Sabit bir "en az 8 karakter" cümlesi, sınırı 12 olan bir havuzda kullanıcıya
    yanlış kuralı söyler; kullanıcı formu doldurur, sunucu reddeder ve hata alanın
    yanında değil özet bölgesinde çıkar.

    Politika bilinmiyorsa HİÇBİR ŞEY yazılmaz. Yedek bir varsayılan koymak, ikinci
    bir doğruluk kaynağı yaratır ve havuz politikası değiştiğinde sessizce yanlışa
    döner — kural göstermemek, yanlış kural göstermekten iyidir.

    Liste hâlinde: iki dilde doğru bir bileşik cümle kurmak yerine her kural kendi
    satırında duruyor.
*@
@if (Model is not null)
{
    var rules = new List<string> { T["Password.Rules.MinLength", Model.MinLength].Value };

    if (Model.RequireUppercase) rules.Add(T["Password.Rules.Uppercase"].Value);
    if (Model.RequireLowercase) rules.Add(T["Password.Rules.Lowercase"].Value);
    if (Model.RequireDigit) rules.Add(T["Password.Rules.Digit"].Value);
    if (Model.RequireNonAlphanumeric) rules.Add(T["Password.Rules.NonAlphanumeric"].Value);

    // Boşluk yasağı politikadan gelmiyor; doğrulayıcıda koşulsuz (^\S+$) olduğu
    // için her zaman yazılır.
    rules.Add(T["Password.Rules.NoWhitespace"].Value);

    <div class="auth-field__hint" id="Password-hint">
        <p>@T["Password.Rules.Intro"]</p>
        <ul class="auth-rules">
            @foreach (var rule in rules)
            {
                <li>@rule</li>
            }
        </ul>
    </div>
}
