{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MassTransit": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "idp_route": {
        "ClusterId": "idp_cluster",
        "Order": -1,
        "Match": {
          "Path": "/idp/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/idp"
          },
          {
            "RequestHeaderOriginalHost": "false"
          },
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "management_route": {
        "ClusterId": "management_cluster",
        "Order": -1,
        "Match": {
          "Path": "/management/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/management"
          },
          {
            "RequestHeaderOriginalHost": "false"
          },
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "authz_route": {
        "ClusterId": "authz_cluster",
        "Order": -1,
        "Match": {
          "Path": "/authz/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "false"
          },
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "systemmessage_route": {
        "ClusterId": "systemmessage_cluster",
        "Match": {
          "Path": "/systemmessage/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/systemmessage"
          }
        ]
      }
    },
    "Clusters": {
      "idp_cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7042"
          }
        }
      },
      "management_cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7097"
          }
        }
      },
      "authz_cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true,
          "EnableMultipleHttp2Connections": true
        },
        "HttpRequest": {
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7132"
          }
        }
      },
      "systemmessage_cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7153"
          }
        }
      }
    }
  }
}
