@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <p class="crumb"><a href="/@lang/games">Games</a> / Block Boosters</p>
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">A Boosters Labs game</span>
                <h1 class="reveal reveal-d1">Block Boosters</h1>
                <p class="lead reveal reveal-d2">
                    Match blocks, chain combos and dive into a puzzle/action experience that gets a little
                    tougher every level. Easy to pick up, hard to put down.
                </p>
                <div class="tags mt-2 reveal reveal-d2">
                    <span class="pill pill-gold">Puzzle / action</span>
                    <span class="pill">Family friendly</span>
                    <span class="pill">Coming soon</span>
                </div>
                <div class="actions mt-3 reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/games">@m.T("cta.back.games")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Block Boosters emblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">About the game</span>
            <h2 class="reveal reveal-d1">Simple rules, deep fun</h2>
            <p class="lead center reveal reveal-d2">
                With fast gameplay and satisfying mechanics, it invites you to play for a few minutes
                or settle in for a long session.
            </p>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 3H4a1 1 0 0 0-1 1v5M15 3h5a1 1 0 0 1 1 1v5M9 21H4a1 1 0 0 1-1-1v-5M15 21h5a1 1 0 0 0 1-1v-5"/></svg></span>
                <h3>Intuitive controls</h3>
                <p>Clear from the very first second. Minutes to learn, a joy to master.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg></span>
                <h3>Satisfying mechanics</h3>
                <p>Every move lands just right; combos and chains keep you coming back.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg></span>
                <h3>Progressively harder levels</h3>
                <p>A gentle start with difficulty that builds over time. New mechanics unlock as you improve.</p>
            </article>
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01M15 9h.01"/></svg></span>
                <h3>Family friendly</h3>
                <p>A clean, positive experience suited to players of every age. Great to play together.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8M12 18v2"/></svg></span>
                <h3>Clean, modern visuals</h3>
                <p>A pleasant, uncluttered and smooth interface. A clear design that keeps focus on play.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Fair and smooth</h3>
                <p>We aim for a player-first experience that never gets in the way of the flow.</p>
            </article>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="eyebrow">Gameplay</span>
                <h2 class="mt-2">A few minutes or hours on end</h2>
                <p class="lead">
                    Block Boosters is simple enough for a quick break and deep enough to keep you playing
                    through long sessions. Every level brings a fresh challenge.
                </p>
                <ul class="ticks mt-2">
                    <li>Jump straight in — no complicated menus</li>
                    <li>Each level brings its own rhythm and puzzle</li>
                    <li>New mechanics unlock as you progress</li>
                </ul>
            </div>
            <div class="split-media reveal reveal-d1">
                <div class="center">
                    <img class="hero-mark" src="~/img/mark-light-512.png" alt="Block Boosters" width="200" height="200" />
                    <h3 class="mt-3">Focus, match, climb</h3>
                    <p>Simple mechanics, deep fun.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section navy">
    <div class="wrap">
        <div class="split flip">
            <div class="split-media reveal">
                <div class="center">
                    <img class="hero-mark" src="~/img/mark-light-512.png" alt="Block Boosters" width="200" height="200" />
                    <h3 class="mt-3">Mobile and web</h3>
                    <p>Coming soon.</p>
                </div>
            </div>
            <div class="reveal reveal-d1">
                <span class="eyebrow">Platform</span>
                <h2 class="mt-2">Reaching players soon</h2>
                <p class="lead">
                    We are preparing Block Boosters for mobile and web. We'll share the details here as the
                    launch gets closer. Get in touch to stay in the loop.
                </p>
                <div class="actions mt-3">
                    <a class="btn btn-light" href="/@lang/contact">@m.T("nav.contact")</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Be the first to know at launch</h2>
            <p class="lead">Write to us for Block Boosters updates or collaboration opportunities.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/games">@m.T("cta.back.games")</a>
            </div>
        </div>
    </div>
</section>
