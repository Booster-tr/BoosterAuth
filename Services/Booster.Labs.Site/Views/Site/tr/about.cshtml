@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">@m.T("nav.about")</span>
                <h1 class="reveal reveal-d1">Guvenli teknolojiyi sade ve size ait sekilde insa ediyoruz.</h1>
                <p class="lead reveal reveal-d2">
                    Boosters Labs; kurumsal kimlik ve yetkilendirme yazilimi <strong>Boosters Auth</strong> ile
                    <strong>Block Boosters</strong> oyununun arkasindaki yazilim ekibidir. Ayni muhendislik
                    titizligini hem kurumsal urunlere hem de oyunlara tasiyoruz.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/products">@m.T("nav.products")</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs amblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="split">
            <div class="reveal">
                <span class="eyebrow">Biz kimiz</span>
                <h2 class="mt-2">Kucuk bir ekip, yuksek bir standart</h2>
                <p class="lead mt-2">
                    Boosters Labs, Turkiye merkezli calisan bir yazilim studyosudur. Isimizin merkezinde
                    guvenlik, sadelik ve musterinin teknolojisine sahip olmasi vardir. Urunlerimizi,
                    verilerinizin ve altyapinizin sizde kalacagi sekilde tasarliyoruz.
                </p>
                <ul class="ticks mt-3">
                    <li>Kurumsal kimlik ve yetki platformu gelistiriyoruz.</li>
                    <li>Her yastan oyuncu icin oyunlar uretiyoruz.</li>
                    <li>On-prem ve cevrimdisi senaryolara oncelik veriyoruz.</li>
                </ul>
            </div>
            <div class="split-media reveal reveal-d1">
                <img class="hero-mark" src="~/img/mark-light-512.png" alt="Boosters Labs amblem" width="280" height="280" />
            </div>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Yon</span>
            <h2 class="reveal reveal-d1">Misyonumuz ve vizyonumuz</h2>
        </div>
        <div class="grid grid-2 mt-4">
            <article class="card reveal">
                <span class="pill pill-gold">Misyon</span>
                <h3 class="mt-2">Guveni varsayilan yapmak</h3>
                <p>
                    Kurumlarin kimlik ve yetki ihtiyacini; anlasilir, standartlara uyumlu ve tamamen
                    kendi kontrollerinde kalan bir yazilimla karsilamak. Teknolojiyi karmasiklastirmadan
                    guvenli hale getirmek.
                </p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="pill pill-gold">Vizyon</span>
                <h3 class="mt-2">Size ait, uzun omurlu urunler</h3>
                <p>
                    Kurumlarin yillarca guvenle calistirabilecegi, baska bir saglayiciya bagimli kalmadan
                    sahip olduklari urunler sunmak. Kurumsal yazilimda ve oyunda ayni kaliteyi
                    surdurulebilir sekilde tekrarlamak.
                </p>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Degerlerimiz</span>
            <h2 class="reveal reveal-d1">Calisma sekillimizi belirleyen ilkeler</h2>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Guvenlik once gelir</h3>
                <p>Guvenlik tasarimdan dagitima kadar varsayilandir; sonradan eklenen bir ozellik degil.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
                <h3>Sadelik</h3>
                <p>Karmasikligi gizlemek yerine azaltiyoruz. Anlasilir urunler, ongorulebilir davranis.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></span>
                <h3>Size ait teknoloji</h3>
                <p>On-prem ve cevrimdisi secenekleriyle verileriniz ve altyapiniz uzerinde tam kontrol.</p>
            </article>
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 7L9 18l-5-5"/></svg></span>
                <h3>Kalite ve sureklilik</h3>
                <p>Kisa yoldan degil, uzun vadede dogru calisacak sekilde insa ediyoruz.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Kullanici gizliligi</h3>
                <p>KVKK ve kisisel veri korumasi urunlerimizin ayrilmaz parcasidir, eklenti degil.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg></span>
                <h3>Musteri yaninda</h3>
                <p>Kurulumdan sonra da yaninizdayiz; sorulariniza anlasilir ve dogrudan yanit veriyoruz.</p>
            </article>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Ne yapiyoruz</span>
            <h2 class="reveal reveal-d1">Iki alan, tek standart</h2>
        </div>
        <div class="grid grid-2 mt-4">
            <article class="card reveal">
                <span class="pill pill-gold">Kurumsal yazilim</span>
                <h3 class="mt-2">Boosters Auth</h3>
                <p>
                    Cok kiracili OIDC/OAuth2 kimlik saglayici ve OpenFGA tabanli yetkilendirme platformu.
                    On-prem calisir, cevrimdisi lisanslanir.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/products/boosters-auth">@m.T("cta.details")</a>
                </div>
            </article>
            <article class="card reveal reveal-d1">
                <span class="pill pill-gold">Oyun</span>
                <h3 class="mt-2">Block Boosters</h3>
                <p>
                    Boosters Labs oyun studyosundan; her yastan oyuncu icin tasarlanmis, hizli ve keyifli
                    bir bulmaca/aksiyon deneyimi.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/games/block-boosters">@m.T("cta.details")</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Birlikte calisalim</h2>
            <p class="lead">Urunlerimiz, oyunlarimiz veya is birligi firsatlari hakkinda konusmak icin bize ulasin.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/products">@m.T("nav.products")</a>
            </div>
        </div>
    </div>
</section>
