<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CommonInternal\Booster.Auth.Database\Booster.Auth.Database.csproj" />

    <!-- Parolasiz saglayicilarin ortak iskeleti tek kullanimlik kodu onbellekte
         tutar (ISecureCacheStore) ve ozetini alir (ISimpleHasher). -->
    <ProjectReference Include="..\..\Common\Caching\Booster.Caching.Abstraction\Booster.Caching.Abstraction.csproj" />
    <ProjectReference Include="..\..\Common\Booster.Hashing\Booster.Hashing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Federasyon: dis saglayiciya HTTP cagrisi icin IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />

    <!-- OIDC discovery belgesi ve JWKS yonetimi. ConfigurationManager belgeyi ve
         imza anahtarlarini onbellege alip suresi gectiginde kendisi yeniler;
         elle yazsak her girise iki ek HTTP cagrisi ve elle anahtar
         gecersizlestirme dusecekti. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

</Project>
