@{
    var email = User.FindFirst("email")?.Value;
    var isAdminArea = Context.Request.Path.StartsWithSegments("/admin");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} - " : "")Booster Auth</title>
    <meta name="description" content="Booster Auth: kendi sunucunuzda OpenID Connect kimlik sağlayıcı, kullanıcı ve yetki yönetimi." />
    <meta name="theme-color" content="#173F38" />
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" href="/tr" aria-label="Booster Auth ana sayfa"><img class="brand-mark" src="/img/logo.svg" alt="" width="26" height="26" />Booster <span>Auth</span></a>
    <nav class="nav nav-site" aria-label="Site">
        <a href="/tr">Ürün</a>
        <a href="/tr/docs">Dokümantasyon</a>
        <a href="/tr/pricing">Paketler</a>
        <a href="/tr/download">İndir</a>
    </nav>
    @if (isAdminArea)
    {
        <nav class="nav" aria-label="Yönetim">
            <a href="/admin">Genel</a>
            <a href="/admin/musteriler">Müşteriler</a>
            <a href="/admin/lisanslar">Lisanslar</a>
            <a href="/admin/siparisler?status=Pending">Siparişler</a>
            <a href="/admin/planlar">Planlar</a>
            <a href="/hesap">Müşteri alanı</a>
        </nav>
    }
    else if (email is not null)
    {
        <nav class="nav" aria-label="Hesap">
            <a href="/hesap/kurulumlar">Kurulumlarım</a>
            <a href="/hesap/siparisler">Siparişlerim</a>
            <a href="/hesap/firma">Firma bilgileri</a>
        </nav>
    }
    <div class="user">
        @if (email is not null)
        {
            <span class="muted">@email</span>
            <form method="post" action="/cikis" asp-antiforgery="true"><button class="btn btn-ghost" type="submit">Çıkış</button></form>
        }
        else
        {
            <a class="btn btn-primary" href="/giris">Giriş yap</a>
        }
    </div>
</header>
<main class="container">
    @RenderBody()
</main>
<footer class="portal-foot">
    <span>© @DateTime.UtcNow.Year Booster Auth</span>
    <span>Destek: <a href="@Booster.Licensing.Portal.Site.SiteCatalog.SupportPhoneHref">@Booster.Licensing.Portal.Site.SiteCatalog.SupportPhone</a>
        · <a href="mailto:@Booster.Licensing.Portal.Site.SiteCatalog.SupportEmail">@Booster.Licensing.Portal.Site.SiteCatalog.SupportEmail</a>
        · <a href="/tr/help">Yardım</a></span>
    <span>Çevrimdışı lisans · lisans sunucusuna bağlanmaz</span>
    <span class="portal-legal">
        <a href="/tr/legal/sales-terms">Satış Koşulları</a>
        · <a href="/tr/legal/license-agreement">Lisans Sözleşmesi</a>
        · <a href="/tr/legal/privacy">Aydınlatma Metni</a>
        · <a href="/tr/legal/cookies">Çerez Politikası</a>
    </span>
</footer>
<script src="~/js/portal.js" asp-append-version="true"></script>
</body>
</html>
