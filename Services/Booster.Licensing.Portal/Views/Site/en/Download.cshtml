@using Booster.Licensing.Portal.Services
<section class="page-hero">
    <div class="wrap">
        <span class="eyebrow" style="color:var(--teal)">Download</span>
        <h1 class="reveal">Run Booster Auth on your own machine</h1>
        <p class="reveal" style="--d:.08s">The Docker Compose package: every service, PostgreSQL, Redis, Kafka, OpenFGA and the admin console in one folder.</p>
        <div class="cta reveal" style="justify-content:center;--d:.16s">
            <a class="btn btn-primary btn-lg" href="/download/@InstallPackage.FileName" data-download>Download @InstallPackage.FileName <span class="arrow">↓</span></a>
            <a class="btn btn-ghost btn-lg" href="/en/docs/installation">Detailed installation guide</a>
        </div>
        <p class="muted small reveal" style="--d:.2s">Free · You get the license after installing · About 15 KB</p>
    </div>
</section>

<section class="section">
    <div class="wrap grid-2" style="align-items:start;gap:3rem">
        <div class="reveal">
            <h2>Install with four commands</h2>
            <div class="steps" style="grid-template-columns:1fr;gap:1rem;margin-top:1.5rem">
                <div class="step"><h3>Unzip the package</h3><p>Unzip the file and change into the <code>booster-auth</code> folder.</p></div>
                <div class="step"><h3>Run the setup script</h3><p>It asks for your Booster Auth address (e.g. <code>auth.company.com</code>) and the console address, generates every password and key and writes the <code>.env</code> file.</p></div>
                <div class="step"><h3>Start</h3><p><code>docker compose up -d</code>. The first start downloads the images and takes a few minutes.</p></div>
                <div class="step"><h3>Sign in and get a license</h3><p>Sign in as <code>admin</code> and change the initial password. <b>System &gt; License</b> → <b>Get a license</b> takes you to the license portal.</p></div>
            </div>
        </div>
        <div class="reveal" style="--d:.08s">
            <div class="terminal">
                <div class="terminal-bar"><i></i><i></i><i></i></div>
<pre><span class="c"># Linux / macOS</span>
<span class="p">$</span> unzip booster-auth.zip &amp;&amp; cd booster-auth
<span class="p">$</span> ./kurulum.sh
<span class="p">$</span> docker compose up -d

<span class="c"># Windows (PowerShell)</span>
<span class="p">&gt;</span> Expand-Archive booster-auth.zip .
<span class="p">&gt;</span> cd booster-auth
<span class="p">&gt;</span> powershell -ExecutionPolicy Bypass -File .\kurulum.ps1
<span class="p">&gt;</span> docker compose up -d</pre>
            </div>
            <div class="callout info" style="margin-top:1.5rem">
                <p><b>Local trial.</b> If your address is not in DNS yet, add <code>127.0.0.1 auth.company.com</code> to your <code>hosts</code> file.
                    The Booster Auth address must be on one of the domains in your license.</p>
            </div>
            <div class="callout tip">
                <p><b>Note.</b> The setup scripts and the bundled <code>BENIOKU.md</code> are currently in Turkish; the steps are the same as on this page.</p>
            </div>
            <h3 style="margin-top:2rem">Requirements</h3>
            <ul class="muted">
                <li>Docker Engine 24+ and Docker Compose v2 (Windows / macOS: Docker Desktop)</li>
                <li>At least 4 GB of free memory and 10 GB of disk</li>
                <li>Internet access during installation (images are pulled from <code>ghcr.io/booster-tr</code>)</li>
            </ul>
            <h3 style="margin-top:1.5rem">Package contents</h3>
            <ul class="muted">
                @foreach (var f in Model.PackageFiles) { <li><code>booster-auth/@f</code></li> }
            </ul>
        </div>
    </div>
</section>
