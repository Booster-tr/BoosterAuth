{
  "Version": "0.1.7",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IdpUiOptions": {
    "LoginPath": "/ui/login",
    "ConsentPath": "/ui/consent",
    "ErrorPath": "/ui/error",
    "AuthorizePath": "/authorize",
    "ForgotPasswordPath": "/ui/forgot-password",
    "ResetPasswordPath": "/ui/reset-password",
    "ChangePasswordPath": "/ui/change-password",
    "PasswordlessPath": "/ui/passwordless",
    "PasswordlessVerifyPath": "/ui/passwordless/verify",
    "ExternalChallengePath": "/ui/external/challenge",
    "ExternalCallbackPath": "/ui/external/callback",
    "ExternalConflictPath": "/ui/external/conflict"
  }
}
