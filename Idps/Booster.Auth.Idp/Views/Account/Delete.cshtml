@model Booster.Auth.Idp.Controllers.AccountPageModel
@using Booster.Auth.Idp.Controllers
@* Hesap silme onayi. Yalnizca havuz politikasi izin veriyorsa acilir (AccountService.CanDelete). *@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Delete.Heading"].Value;
    var confirmInvalid = ViewData.ModelState.HasError("Confirm");
}

<section class="auth-card">
    <header class="auth-card__header">
        <h1 class="auth-card__title">@T["Delete.Heading"]</h1>
        <p class="auth-card__subtitle">@T["Delete.Subtitle"]</p>
    </header>

    <partial name="_ValidationSummary" />

    <ul class="account-effects">
        <li>@T["Delete.Effect1"]</li>
        <li>@T["Delete.Effect2"]</li>
        <li>@T["Delete.Effect3"]</li>
    </ul>

    <form method="post" action="@Url.Idp("/ui/account/delete")" class="auth-form" data-auth-form asp-antiforgery="false">
        <partial name="_Hidden" model="Model" />
        @if (Model.HasPassword && !Model.DirectoryManaged)
        {
            <partial name="_Field" model="@(new AccountFieldModel("CurrentPassword", T["Contact.CurrentPassword"].Value, Type: "password", Autocomplete: "current-password", Autofocus: true))" />
        }
        <div class="auth-field @(confirmInvalid ? "auth-field--invalid" : null)">
            <label class="account-check">
                <input type="checkbox" id="Confirm" name="Confirm" value="true" aria-describedby="Confirm-error" />
                <span>@T["Delete.Confirm"]</span>
            </label>
            <partial name="_FieldError" model="@("Confirm")" />
        </div>
        <div class="auth-form__actions">
            <button type="submit" class="auth-btn auth-btn--danger auth-btn--block" data-submit-guard>
                <span class="auth-btn__spinner" aria-hidden="true"></span>
                <span class="auth-btn__label">@T["Delete.Submit"]</span>
            </button>
        </div>
    </form>

    <div class="account-back">
        <a class="auth-link auth-link--standalone auth-link--sm" href="@Url.Idp($"/ui/account?{Model.Query}")">@T["Account.Cancel"]</a>
    </div>
</section>
