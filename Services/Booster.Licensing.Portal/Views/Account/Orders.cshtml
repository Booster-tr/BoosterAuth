@model List<Order>
@{ ViewData["Title"] = "Siparişlerim"; }
<h1>Siparişlerim</h1>
@if (Model.Count == 0)
{
    <p class="muted">Henüz sipariş vermediniz. <a href="/hesap/kurulumlar">Kurulumlarım</a> ekranından lisans satın alabilirsiniz.</p>
}
else
{
    <table>
        <thead><tr><th>Referans</th><th>Plan</th><th>Kurulum</th><th>Tarih</th><th>Durum</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td><code>@o.ReferenceCode</code></td><td>@o.PlanName</td><td><code>@o.InstallationId</code></td>
                <td>@o.CreatedTime.ToString("yyyy-MM-dd")</td>
                <td><span class="tag @(o.Status == OrderStatus.Paid ? "tag-ok" : "tag-warn")">@(o.Status switch { OrderStatus.Pending => "Ödeme bekleniyor", OrderStatus.Paid => "Ödeme alındı", _ => "İptal" })</span></td>
                <td><a class="btn btn-ghost btn-sm" href="/hesap/siparis?OrderId=@o.Id">Ayrıntı</a></td>
            </tr>
        }
        </tbody>
    </table>
}
