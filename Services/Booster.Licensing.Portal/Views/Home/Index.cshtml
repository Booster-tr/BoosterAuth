@{ ViewData["Title"] = "Hoş geldiniz"; }
<section class="hero">
    <h1>Booster Auth lisansları</h1>
    <p class="lead">Kurulumunuz için deneme lisansı alın, lisans satın alın veya yenileyin.</p>
    <ol class="steps">
        <li>Booster Auth yönetim panelinde <b>Sistem &gt; Lisans</b> ekranından kurulum GUID'inizi kopyalayın.</li>
        <li>Bu portala giriş yapın ya da hesap oluşturun.</li>
        <li>Lisansınızı alın ve token'ı panele yapıştırın.</li>
    </ol>
    <a class="btn btn-primary btn-lg" href="/giris">Giriş yap / Hesap oluştur</a>
</section>
