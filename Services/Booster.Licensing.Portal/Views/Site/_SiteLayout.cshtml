@using Booster.Licensing.Portal.Site
@inject Booster.Licensing.Portal.Options.LicensingPortalOptions Options
@{
    var m = (SitePageModel)Model!;
    var lang = m.Lang;
    var other = lang == "tr" ? "en" : "tr";
    var baseUrl = Options.PublicUrl.TrimEnd('/');
    var cur = m.Page;
    var canonical = baseUrl + cur.Path(lang);
    var title = cur == SiteCatalog.Home ? $"{SiteCatalog.ProductName} · {cur.SeoTitle(lang)}" : $"{cur.SeoTitle(lang)} · {SiteCatalog.ProductName}";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var portalHref = signedIn ? "/hesap" : "/giris?returnUrl=%2Fhesap";
    bool Active(string slug) => slug.Length == 0 ? cur == SiteCatalog.Home : cur.Slug == slug || cur.Slug.StartsWith(slug + "/");
    string? Current(string slug) => Active(slug) ? "page" : null;
}
<!DOCTYPE html>
<html lang="@lang" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@cur.Description(lang)" />
    <link rel="canonical" href="@canonical" />
    @foreach (var l in SiteCatalog.Languages)
    {
        <link rel="alternate" hreflang="@l" href="@(baseUrl + cur.Path(l))" />
    }
    <link rel="alternate" hreflang="x-default" href="@(baseUrl + cur.Path(SiteCatalog.DefaultLanguage))" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteCatalog.ProductName" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@cur.Description(lang)" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="@(lang == "tr" ? "tr_TR" : "en_US")" />
    <meta property="og:locale:alternate" content="@(lang == "tr" ? "en_US" : "tr_TR")" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#173F38" />
    <link rel="icon" href="/img/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (cur == SiteCatalog.Home)
    {
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "Booster Auth",
          "applicationCategory": "SecurityApplication",
          "operatingSystem": "Linux, Windows, macOS (Docker)",
          "description": "@cur.Description(lang)",
          "url": "@canonical",
          "inLanguage": "@lang",
          "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "TRY", "description": "@(lang == "tr" ? "7 günlük ücretsiz deneme" : "7-day free trial")" }
        }
        </script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="site @(cur.DocGroup is not null ? "is-docs" : "")">
<a class="skip" href="#main">@m.T("skip")</a>

<header class="top">
    <div class="wrap">
        <a class="brand" href="/@lang" aria-label="@m.T("home")">
            @SiteArt.Mark()
            Booster <small>Auth</small>
        </a>
        <nav class="nav" aria-label="@m.T("nav.main")">
            <a href="/@lang" aria-current="@Current("")">@m.T("nav.product")</a>
            <a href="/@lang/features" aria-current="@Current("features")">@m.T("nav.features")</a>
            <a href="/@lang/docs" aria-current="@Current("docs")">@m.T("nav.docs")</a>
            <a href="/@lang/pricing" aria-current="@Current("pricing")">@m.T("nav.pricing")</a>
            <a href="/@lang/download" aria-current="@Current("download")">@m.T("nav.download")</a>
            <a href="/@lang/help" aria-current="@Current("help")">@m.T("nav.help")</a>
        </nav>
        <div class="top-right">
            <a class="portal" href="@portalHref">@SiteArt.Lock() @m.T("nav.portal")</a>
            <div class="lang" role="group" aria-label="@m.T("nav.lang")">
                @if (lang == "tr")
                {
                    <span aria-current="true">TR</span><a href="@cur.Path("en")" hreflang="en" lang="en" title="English">EN</a>
                }
                else
                {
                    <a href="@cur.Path("tr")" hreflang="tr" lang="tr" title="Türkçe">TR</a><span aria-current="true">EN</span>
                }
            </div>
            <details class="menu" data-menu>
                <summary>@m.T("menu")</summary>
                <nav aria-label="@m.T("nav.mobile")">
                    <a href="/@lang" aria-current="@Current("")">@m.T("nav.product")</a>
                    <a href="/@lang/features" aria-current="@Current("features")">@m.T("nav.features")</a>
                    <a href="/@lang/docs" aria-current="@Current("docs")">@m.T("nav.docs")</a>
                    <a href="/@lang/pricing" aria-current="@Current("pricing")">@m.T("nav.pricing")</a>
                    <a href="/@lang/download" aria-current="@Current("download")">@m.T("nav.download")</a>
                    <a href="/@lang/help" aria-current="@Current("help")">@m.T("nav.help")</a>
                    <a href="@portalHref">@m.T("nav.portal")</a>
                </nav>
            </details>
        </div>
    </div>
</header>

<main id="main">
    @RenderBody()
</main>

<footer class="foot-band">
    <div class="wrap">
        <div class="foot">
            <div>
                <a class="brand" href="/@lang" aria-label="@m.T("home")">@SiteArt.Mark(onDark: true) Booster <small>Auth</small></a>
                <p class="foot-tag">@m.T("footer.tagline")</p>
            </div>
            <div>
                <h2 class="foot-h">@m.T("footer.product")</h2>
                <ul>
                    <li><a href="/@lang">@m.T("nav.product")</a></li>
                    <li><a href="/@lang/features">@m.T("nav.features")</a></li>
                    <li><a href="/@lang/pricing">@m.T("nav.pricing")</a></li>
                    <li><a href="/@lang/download">@m.T("nav.download")</a></li>
                </ul>
            </div>
            <div>
                <h2 class="foot-h">@m.T("footer.resources")</h2>
                <ul>
                    @foreach (var d in SiteCatalog.Docs.Skip(1).Take(5))
                    {
                        <li><a href="@d.Path(lang)">@d.Title(lang)</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2 class="foot-h">@m.T("footer.account")</h2>
                <ul>
                    <li><a href="/giris?returnUrl=%2Fhesap">@m.T("footer.signin")</a></li>
                    <li><a href="/hesap/kurulumlar">@m.T("footer.installations")</a></li>
                    <li><a href="/hesap/siparisler">@m.T("footer.orders")</a></li>
                    <li><a href="@cur.Path(other)" hreflang="@other" lang="@other">@m.T("lang.switch")</a></li>
                </ul>
            </div>
            <div>
                <h2 class="foot-h">@m.T("footer.support")</h2>
                <ul>
                    <li><a href="@SiteCatalog.SupportPhoneHref">@SiteCatalog.SupportPhone</a></li>
                    <li><a href="mailto:@SiteCatalog.SupportEmail">@SiteCatalog.SupportEmail</a></li>
                    <li><a href="/@lang/help">@m.T("footer.helpcenter")</a></li>
                </ul>
            </div>
        </div>
        <nav class="foot-legal" aria-label="@m.T("footer.legal")">
            <span class="foot-h">@m.T("footer.legal")</span>
            @foreach (var d in SiteCatalog.Legal)
            {
                <a href="@d.Path(lang)">@d.Title(lang)</a>
            }
        </nav>
        <div class="foot-base"><span>© @DateTime.UtcNow.Year Booster Auth. @m.T("footer.rights")</span><span>@m.T("footer.note")</span></div>
    </div>
</footer>
<script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
