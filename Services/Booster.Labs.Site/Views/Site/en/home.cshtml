@{ var m = (SitePageModel)Model!; var lang = m.Lang; }

<section class="hero hero-glow">
    <div class="wrap">
        <div class="hero-grid">
            <div class="hero-copy">
                <span class="eyebrow reveal">Boosters Labs</span>
                <h1 class="reveal reveal-d1">Secure identity, clear authorization, memorable games.</h1>
                <p class="lead reveal reveal-d2">
                    Boosters Labs is the team behind <strong>Boosters Auth</strong>, our enterprise identity and
                    authorization platform, and the game <strong>Block Boosters</strong>. We build technology that is
                    secure, scalable and truly yours.
                </p>
                <div class="actions reveal reveal-d3">
                    <a class="btn btn-primary btn-lg" href="/@lang/products">Explore our products</a>
                    <a class="btn btn-outline-light btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                </div>
            </div>
            <div class="hero-art reveal reveal-d2">
                <img class="hero-mark" src="~/img/mark-dark-512.png" alt="Boosters Labs emblem" width="320" height="320" />
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">What we do</span>
            <h2 class="reveal reveal-d1">Two fields, one standard: trust</h2>
            <p class="lead center reveal reveal-d2">
                We bring enterprise software and game development together with the same engineering rigor.
            </p>
        </div>
        <div class="grid grid-2 mt-4">
            <article class="card reveal">
                <span class="pill pill-gold">Product</span>
                <h3 class="mt-2">Boosters Auth</h3>
                <p>
                    A multi-tenant OIDC/OAuth2 identity provider with OpenFGA-based authorization.
                    Runs on-prem, licensed offline; your data stays with you.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/products/boosters-auth">@m.T("cta.details")</a>
                </div>
            </article>
            <article class="card reveal reveal-d1">
                <span class="pill pill-gold">Game</span>
                <h3 class="mt-2">Block Boosters</h3>
                <p>
                    From the Boosters Labs game studio: a fast, enjoyable puzzle/action experience
                    designed for players of every age.
                </p>
                <div class="actions">
                    <a class="btn btn-ghost" href="/@lang/games/block-boosters">@m.T("cta.details")</a>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section alt">
    <div class="wrap">
        <div class="head-block center">
            <span class="eyebrow reveal">Why Boosters Labs</span>
            <h2 class="reveal reveal-d1">The principles we stand on</h2>
        </div>
        <div class="grid grid-3 mt-4">
            <article class="card reveal">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
                <h3>Security first</h3>
                <p>From design to deployment, security is the default — never an afterthought.</p>
            </article>
            <article class="card reveal reveal-d1">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>
                <h3>Simplicity &amp; clarity</h3>
                <p>We reduce complexity instead of hiding it. Understandable products, predictable behavior.</p>
            </article>
            <article class="card reveal reveal-d2">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></span>
                <h3>It should be yours</h3>
                <p>With on-prem and offline options, you keep full control of your data and infrastructure.</p>
            </article>
        </div>
    </div>
</section>

<section class="section navy">
    <div class="wrap">
        <div class="stats">
            <div class="stat reveal"><b>100%</b><span>On-prem &amp; offline</span></div>
            <div class="stat reveal reveal-d1"><b>2</b><span>Languages (TR / EN)</span></div>
            <div class="stat reveal reveal-d2"><b>OIDC</b><span>Standards compliant</span></div>
            <div class="stat reveal reveal-d3"><b>24/7</b><span>Uninterrupted identity</span></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="wrap">
        <div class="cta-band reveal">
            <h2>Let's work together</h2>
            <p class="lead">Reach out to talk about our products, our games, or partnership opportunities.</p>
            <div class="actions center">
                <a class="btn btn-primary btn-lg" href="/@lang/contact">@m.T("cta.contact")</a>
                <a class="btn btn-outline-light btn-lg" href="/@lang/about">@m.T("nav.about")</a>
            </div>
        </div>
    </div>
</section>
